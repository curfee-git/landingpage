---
import { getRoutes } from '@/configurations/routes';
import { getTranslations } from '@/i18n/translations';
import logoTextRaw from '@/assets/logos/logo_text.svg?raw';

const t = getTranslations(Astro.currentLocale);
const routes = getRoutes(Astro.currentLocale);
const menuId = 'mobile-menu';

const navItems = [
  { id: 'selected-engagements', label: t['nav.engagements'] },
  { id: 'pattern', label: t['nav.pattern'] },
  { id: 'method', label: t['nav.method'] },
  { id: 'about', label: t['nav.about'] },
  { id: 'faq', label: t['nav.faq'] },
].map((item) => ({ ...item, href: `${routes.home}#${item.id}` }));

const navClass = "px-4 py-3 text-label-large font-semibold whitespace-nowrap text-ink-primary hover:text-brand-primary transition-colors duration-200 ease-standard";
const menuItemClass = "flex items-center px-4 py-3 text-label-large font-semibold transition-colors duration-200 ease-standard text-ink-primary hover:text-brand-primary";
---

<header role="banner" data-header transition:persist class="fixed inset-x-0 top-0 z-50">
  <div data-header-shell class="mx-auto max-w-300 flex items-center justify-between gap-3 w-full relative h-[var(--header-height)] px-gutter xl:px-0">
    <a href={routes.home} data-logo class="shrink-0 inline-flex items-center gap-2 text-brand-primary" aria-label={t['header.aria.brand']} data-menu-close>
      <span class="block h-5 [&>svg]:h-full [&>svg]:max-h-full [&>svg]:w-auto" aria-hidden="true" set:html={logoTextRaw} />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label={t['header.aria.main']}>
      {navItems.map((item) => (
        <a href={item.href} class={navClass} data-nav-link>{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-1 shrink-0 z-10">
      <a href={routes.contact} data-header-cta class="hidden sm:inline-flex items-center justify-center gap-2 bg-brand-primary text-brand-primary-foreground hover:bg-brand-primary-hover px-6 py-3.5 rounded-full text-sm font-bold leading-none whitespace-nowrap transition-colors duration-200 ease-standard">
        <span>{t['nav.cta']}</span>
      </a>
      <button type="button" class="lg:hidden inline-flex h-12 w-12 items-center justify-center rounded-full text-ink-primary hover:bg-ink-primary/8 transition-all duration-200 ease-standard" aria-label={t['header.aria.toggle']} aria-expanded="false" aria-controls={menuId} data-menu-toggle>
        <span data-icon-closed>
          <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </span>
        <span data-icon-open class="hidden">
          <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </span>
      </button>
    </div>
  </div>

  <div id={menuId} inert data-mobile-menu class="lg:hidden transition-all duration-200 ease-standard max-h-0 opacity-0 pointer-events-none overflow-hidden">
    <div class="max-w-7xl mx-auto px-gutter pb-4 space-y-2">
      <nav class="flex flex-col gap-1" aria-label={t['header.aria.mobile']}>
        {navItems.map((item) => (
          <a href={item.href} class={menuItemClass} data-menu-close data-nav-link>{item.label}</a>
        ))}
      </nav>
      <div class="lg:hidden flex flex-col gap-2 px-4 pt-2">
        <a href={routes.contact} data-header-cta class="inline-flex items-center justify-center gap-2 bg-brand-primary text-brand-primary-foreground hover:bg-brand-primary-hover px-6 py-3.5 rounded-full text-sm font-bold leading-none transition-colors duration-200 ease-standard" data-menu-close>{t['nav.cta']}</a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Adaptive foreground colours: flip to light over dark sections */
  [data-header] {
    --header-fg: var(--ink-primary);
    --header-logo: var(--brand-primary);
  }
  [data-header][data-theme="dark"] {
    --header-fg: 255 255 255;
    --header-logo: 255 255 255;
  }
  [data-logo] {
    color: rgb(var(--header-logo));
    transition: color 300ms var(--header-ease, ease);
  }
  [data-logo] :global(svg),
  [data-logo] :global(svg *) {
    fill: rgb(var(--header-logo));
    transition: fill 300ms var(--header-ease, ease);
  }
  [data-nav-link],
  [data-menu-toggle] {
    color: rgb(var(--header-fg));
    transition: color 300ms var(--header-ease, ease);
  }
  [data-nav-link]:hover,
  [data-nav-link][data-active] {
    color: rgb(var(--brand-primary));
  }
  [data-header][data-theme="dark"] [data-nav-link]:hover,
  [data-header][data-theme="dark"] [data-nav-link][data-active] {
    color: rgb(255 255 255);
    opacity: 0.75;
  }
  [data-header][data-theme="dark"] [data-header-cta] {
    background-color: rgb(255 255 255);
    color: rgb(var(--brand-primary));
  }
  [data-header][data-theme="dark"] [data-header-cta]:hover {
    background-color: rgb(255 255 255 / 0.88);
  }

  /* Liquid glass header */
  [data-header] {
    --header-duration: 500ms;
    --header-ease: cubic-bezier(0.25, 0.1, 0.25, 1);
    transition: top var(--header-duration) var(--header-ease);
  }
  /* Firefox refuses to sample the backdrop for a negative-z-index pseudo and for
     3D-transformed filter layers, so the glass layer sits at z-index 0 with the
     header content lifted above it instead. */
  [data-header]::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: transparent;
    backdrop-filter: blur(12px) saturate(120%);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    transition: left var(--header-duration) var(--header-ease),
                right var(--header-duration) var(--header-ease),
                border-radius var(--header-duration) var(--header-ease),
                background-color var(--header-duration) var(--header-ease);
  }
  /* Below the desktop pill the bar keeps its full width, so a blur alone stays
     invisible over flat sections. Tint it once it overlaps content. */
  @media (max-width: 1023px) {
    [data-header][data-scrolled]::before,
    [data-header][data-menu-open]::before {
      background-color: rgb(var(--surface-base) / 0.82);
    }
    [data-header][data-theme="dark"][data-scrolled]::before,
    [data-header][data-theme="dark"][data-menu-open]::before {
      background-color: rgb(var(--brand-primary) / 0.82);
    }
  }
  [data-header-shell],
  [data-mobile-menu] {
    position: relative;
    z-index: 1;
  }
  [data-header-shell] {
    transition: height var(--header-duration) var(--header-ease),
                max-width var(--header-duration) var(--header-ease),
                padding var(--header-duration) var(--header-ease);
  }
  /* Collapse into the floating pill on desktop only; mobile stays full width */
  @media (min-width: 1024px) {
    [data-header][data-scrolled] {
      top: 0.75rem;
    }
    [data-header][data-scrolled]::before {
      left: max(0.75rem, calc(50% - 32rem));
      right: max(0.75rem, calc(50% - 32rem));
      border-radius: 1.25rem;
    }
    [data-header][data-scrolled] [data-header-shell] {
      height: 4rem;
      max-width: 64rem;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-header],
    [data-header]::before,
    [data-header-shell] {
      transition: none;
    }
  }
</style>

<script>
  let cleanupHandlers: Array<() => void> = [];

  function runCleanup() {
    for (const fn of cleanupHandlers) {
      try { fn(); } catch {  }
    }
    cleanupHandlers = [];
  }

  function initMobileMenu() {
    const header = document.querySelector('[data-header]') as HTMLElement | null;
    const toggle = header?.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
    const menu = header?.querySelector('[data-mobile-menu]') as HTMLElement | null;
    if (!header || !toggle || !menu) return;

    const iconOpen = toggle.querySelector('[data-icon-open]') as HTMLElement | null;
    const iconClosed = toggle.querySelector('[data-icon-closed]') as HTMLElement | null;
    const closeTargets = header.querySelectorAll('[data-menu-close]');

    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      menu.style.maxHeight = open ? `${menu.scrollHeight}px` : '0px';
      menu.style.opacity = open ? '1' : '0';
      menu.style.pointerEvents = open ? 'auto' : 'none';
      menu.inert = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      header.toggleAttribute('data-menu-open', open);
      if (iconOpen && iconClosed) {
        iconOpen.style.display = open ? 'block' : 'none';
        iconClosed.style.display = open ? 'none' : 'block';
      }
    };

    const onToggle = () => setOpen(!open);
    toggle.addEventListener('click', onToggle);
    cleanupHandlers.push(() => toggle.removeEventListener('click', onToggle));

    closeTargets.forEach((el) => {
      const fn = () => setOpen(false);
      el.addEventListener('click', fn);
      cleanupHandlers.push(() => el.removeEventListener('click', fn));
    });

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && open) { setOpen(false); toggle.focus(); }
    };
    document.addEventListener('keydown', onKeyDown);
    cleanupHandlers.push(() => document.removeEventListener('keydown', onKeyDown));

    const onDocClick = (e: MouseEvent) => {
      if (open && !header.contains(e.target as Node)) setOpen(false);
    };
    document.addEventListener('click', onDocClick);
    cleanupHandlers.push(() => document.removeEventListener('click', onDocClick));
  }

  function initScrollSpy() {
    const links = Array.from(document.querySelectorAll('[data-nav-link]')) as HTMLAnchorElement[];
    const ids: string[] = [];
    for (const l of links) {
      const id = l.hash.replace(/^#/, '');
      if (id && !ids.includes(id)) ids.push(id);
    }
    const sections = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (sections.length === 0) return;

    let active = '';
    const setActive = (id: string) => {
      if (id === active) return;
      active = id;
      links.forEach((l) => l.toggleAttribute('data-active', l.hash === `#${id}`));
    };
    const clearActive = () => {
      if (!active) return;
      active = '';
      links.forEach((l) => l.removeAttribute('data-active'));
    };

    const onScroll = () => {
      const middle = window.scrollY + window.innerHeight * 0.35;
      if (middle < sections[0].offsetTop) { clearActive(); return; }
      let current = '';
      for (const s of sections) {
        if (s.offsetTop <= middle) current = s.id;
      }
      if (current) setActive(current); else clearActive();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    cleanupHandlers.push(() => window.removeEventListener('scroll', onScroll));
    onScroll();
  }

  function initHeaderScroll() {
    const header = document.querySelector('[data-header]') as HTMLElement | null;
    if (!header) return;

    let scrolled = false;
    const onScroll = () => {
      const threshold = scrolled ? 40 : 80;
      const shouldBeScrolled = window.scrollY > threshold;
      if (shouldBeScrolled !== scrolled) {
        scrolled = shouldBeScrolled;
        header.toggleAttribute('data-scrolled', scrolled);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    cleanupHandlers.push(() => window.removeEventListener('scroll', onScroll));
    onScroll();
  }

  function initHeaderTheme() {
    const header = document.querySelector('[data-header]') as HTMLElement | null;
    if (!header) return;

    const parseColor = (str: string): [number, number, number, number] | null => {
      const m = str.match(/rgba?\(([^)]+)\)/);
      if (!m) return null;
      const parts = m[1].split(/[\s,/]+/).map(Number).filter((n) => !Number.isNaN(n));
      if (parts.length < 3) return null;
      return [parts[0], parts[1], parts[2], parts.length > 3 ? parts[3] : 1];
    };

    // Nearest ancestor with an opaque-enough background color.
    const backgroundOf = (el: Element | null): [number, number, number] | null => {
      let node: Element | null = el;
      while (node && node !== document.documentElement) {
        const c = parseColor(getComputedStyle(node).backgroundColor);
        if (c && c[3] > 0.5) return [c[0], c[1], c[2]];
        node = node.parentElement;
      }
      const body = parseColor(getComputedStyle(document.body).backgroundColor);
      return body ? [body[0], body[1], body[2]] : null;
    };

    // Perceived luminance (WCAG relative luminance).
    const isDark = (r: number, g: number, b: number) => {
      const lin = [r, g, b].map((v) => {
        const s = v / 255;
        return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
      });
      return 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2] < 0.5;
    };

    let raf = 0;
    const evaluate = () => {
      raf = 0;
      const rect = header.getBoundingClientRect();
      const x = Math.round(window.innerWidth / 2);
      const y = Math.round(rect.top + rect.height / 2);
      const stack = document.elementsFromPoint(x, y);
      const behind = stack.find((el) => el !== header && !header.contains(el)) ?? null;
      const bg = backgroundOf(behind);
      if (bg && isDark(bg[0], bg[1], bg[2])) {
        header.setAttribute('data-theme', 'dark');
      } else {
        header.removeAttribute('data-theme');
      }
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(evaluate);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    cleanupHandlers.push(() => {
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      if (raf) cancelAnimationFrame(raf);
    });
    evaluate();
  }

  function init() {
    runCleanup();
    initMobileMenu();
    initScrollSpy();
    initHeaderScroll();
    initHeaderTheme();
  }

  init();
  document.addEventListener('astro:before-swap', runCleanup);
  document.addEventListener('astro:page-load', init);
</script>
