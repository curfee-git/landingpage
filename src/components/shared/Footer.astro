---
import { getRoutes, EXTERNAL } from '@/configurations/routes';
import { BRAND } from '@/configurations/brand';
import { getTranslations } from '@/i18n/translations';
import logoTextRaw from '@/assets/logos/logo_text.svg?raw';

interface Props {
  divider?: boolean;
}

const { divider = false } = Astro.props;
const t = getTranslations(Astro.currentLocale);
const routes = getRoutes(Astro.currentLocale);
const year = new Date().getFullYear();
const isDe = Astro.currentLocale === 'de';
const pathNoLocale = (Astro.url.pathname.replace(/^\/de(\/|$)/, '/') || '/');
const enPath = pathNoLocale;
const dePath = pathNoLocale === '/' ? '/de/' : `/de${pathNoLocale}`;
const linkClass = "text-body-medium text-ink-muted hover:text-brand-primary transition-colors duration-200 ease-standard inline-block";
---

<footer class:list={["pt-16 md:pt-20 pb-12", divider && "border-t border-ink-primary/13"]} style="padding-bottom: max(3rem, env(safe-area-inset-bottom, 3rem));" role="contentinfo">
  <div class="max-w-300 mx-auto px-gutter xl:px-0">

    <div class="flex flex-col gap-10 md:flex-row md:items-start md:gap-16 mb-16">


      <a href={routes.home} class="inline-block w-fit no-underline hover:no-underline focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-primary/40 rounded-sm md:flex-1" aria-label={t['back.home']}>
        <div class="mb-4 inline-flex items-center gap-2 text-brand-primary">
          <span class="block h-5 [&>svg]:h-full [&>svg]:max-h-full [&>svg]:w-auto" aria-hidden="true" set:html={logoTextRaw} />
        </div>
        <p class="text-body-medium text-ink-soft max-w-xs leading-relaxed font-medium">{t['footer.tagline']}</p>
      </a>


      <div class="col-span-1 md:contents grid grid-cols-2 md:grid-cols-none gap-10">
        <div>
          <p class="text-label-large text-ink-primary mb-4">{t['footer.column.socials']}</p>
          <nav class="flex flex-col gap-3" aria-label={t['footer.aria.socials']}>
            <a href={EXTERNAL.linkedin} target="_blank" rel="noopener noreferrer" class={linkClass}>{t['footer.social.linkedin']}</a>
          </nav>
        </div>
        <div>
          <p class="text-label-large text-ink-primary mb-4">{t['footer.column.legal']}</p>
          <nav class="flex flex-col gap-3" aria-label={t['footer.aria.legal']}>
            <a href={routes.imprint} class={linkClass}>{t['footer.legal.notice']}</a>
            <a href={routes.privacy} class={linkClass}>{t['footer.legal.privacy']}</a>
          </nav>
        </div>
      </div>

    </div>


    <div class="pt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-body-small text-ink-muted">
      <span>&copy; {year} {BRAND.name} · {t['footer.copyright']}</span>
      <nav class="inline-flex items-center rounded-full bg-white p-1" aria-label={t['footer.lang.aria']}>
        <a
          href={enPath}
          data-lang-switch="en"
          data-astro-reload
          aria-current={!isDe ? 'true' : undefined}
          class={!isDe
            ? 'px-3.5 py-1.5 rounded-full bg-brand-primary text-brand-primary-foreground font-sans text-xs font-bold no-underline'
            : 'px-3.5 py-1.5 rounded-full text-ink-muted hover:text-brand-primary font-sans text-xs font-bold no-underline transition-colors duration-200 ease-standard'}
        >{t['footer.lang.en']}</a>
        <a
          href={dePath}
          data-lang-switch="de"
          data-astro-reload
          aria-current={isDe ? 'true' : undefined}
          class={isDe
            ? 'px-3.5 py-1.5 rounded-full bg-brand-primary text-brand-primary-foreground font-sans text-xs font-bold no-underline'
            : 'px-3.5 py-1.5 rounded-full text-ink-muted hover:text-brand-primary font-sans text-xs font-bold no-underline transition-colors duration-200 ease-standard'}
        >{t['footer.lang.de']}</a>
      </nav>
    </div>

  </div>
</footer>

<script is:inline>
  document.addEventListener('click', function (e) {
    var target = e.target instanceof Element ? e.target.closest('[data-lang-switch]') : null;
    if (target) {
      try {
        localStorage.setItem('curfee-lang', target.getAttribute('data-lang-switch'));
      } catch (err) {}
    }
  });
</script>
