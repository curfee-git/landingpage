---
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

const paragraphs = [
  t['whycurfee.body.1'],
  t['whycurfee.body.2'],
].filter((p) => p && p.trim());

const startItems = [
  t['whycurfee.start.1'],
  t['whycurfee.start.2'],
  t['whycurfee.start.3'],
].filter((p) => p && p.trim());
---

<section
  id="why-curfee"
  class="section-pad bg-surface-soft"
  aria-labelledby="whycurfee-heading"
>
  <div class="w-full max-w-300 mx-auto px-gutter xl:px-0">

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5 lg:gap-16 items-start">
      <div class="lg:col-span-2">
        <p class="text-eyebrow text-brand-primary m-0">
          {t['whycurfee.eyebrow']}
        </p>
        <h2
          id="whycurfee-heading"
          data-speakable
          class="font-sans text-3xl md:text-4xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto m-0 mt-6"
        >
          <span class="block text-brand-primary">{t['whycurfee.heading.2']}</span>
        </h2>
      </div>

      <div class="lg:col-span-3 flex flex-col gap-5">
        {paragraphs.map((p) => (
          <p data-speakable class="font-sans text-lg leading-relaxed text-ink-muted m-0 max-w-[65ch]">
            {p}
          </p>
        ))}
        <ol class="m-0 p-0 list-none flex flex-col gap-2.5">
          {startItems.map((item, i) => (
            <li class="flex items-baseline gap-4 max-w-[65ch]">
              <span class="font-mono text-sm font-bold text-brand-primary" aria-hidden="true">0{i + 1}</span>
              <span class="font-sans text-lg leading-relaxed text-ink-muted">{item}</span>
            </li>
          ))}
        </ol>
        <p data-speakable class="font-sans text-lg leading-relaxed font-bold text-brand-primary m-0 max-w-[65ch]">
          {t['whycurfee.highlight']}
        </p>
      </div>
    </div>

  </div>
</section>
