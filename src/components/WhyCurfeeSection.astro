---
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

const paragraphs = [
  t['whycurfee.body.1'],
  t['whycurfee.body.2'],
].filter((p) => p && p.trim());

const startItems = [
  t['whycurfee.start.1'],
  t['whycurfee.start.2'],
  t['whycurfee.start.3'],
].filter((p) => p && p.trim());

const payoff = t['whycurfee.payoff'];

const principles = [
  { mark: '01', title: t['howiwork.1.title'], body: t['howiwork.1.body'] },
  { mark: '02', title: t['howiwork.2.title'], body: t['howiwork.2.body'] },
  { mark: '03', title: t['howiwork.3.title'], body: t['howiwork.3.body'] },
];
---

<section
  id="why-curfee"
  class="section-pad bg-surface-soft"
  aria-labelledby="whycurfee-heading"
>
  <div class="w-full max-w-300 mx-auto px-gutter xl:px-0">

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5 lg:gap-16 items-start">
      <div class="lg:col-span-2">
        <p class="text-eyebrow text-brand-primary m-0">
          {t['whycurfee.eyebrow']}
        </p>
        <h2
          id="whycurfee-heading"
          data-speakable
          class="font-sans text-3xl md:text-4xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto m-0 mt-6"
        >
          {t['whycurfee.heading.1'] && <span class="block">{t['whycurfee.heading.1']}</span>}
          <span class="block text-brand-primary">{t['whycurfee.heading.2']}</span>
        </h2>
      </div>

      <div class="lg:col-span-3 flex flex-col gap-5">
        {paragraphs.map((p) => (
          <p data-speakable class="font-sans text-lg leading-relaxed text-ink-muted m-0 max-w-[65ch]">
            {p}
          </p>
        ))}
        <ol class="m-0 p-0 list-none flex flex-col gap-2.5">
          {startItems.map((item, i) => (
            <li class="flex items-baseline gap-4 max-w-[65ch]">
              <span class="font-mono text-sm font-bold text-brand-primary" aria-hidden="true">0{i + 1}</span>
              <span class="font-sans text-lg leading-relaxed text-ink-muted">{item}</span>
            </li>
          ))}
        </ol>
        {payoff && (
          <p data-speakable class="font-sans text-lg leading-relaxed font-bold text-brand-primary m-0 max-w-[65ch]">
            {payoff}
          </p>
        )}
      </div>
    </div>

    <div class="mt-16 lg:mt-20 bg-white border border-ink-primary/13 rounded-lg overflow-hidden shadow-[0_1px_3px_rgb(var(--ink-primary)/0.08),0_12px_32px_rgb(var(--ink-primary)/0.07)]">

      <div class="px-8 lg:px-10 py-4 border-b border-ink-primary/10">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-brand-primary m-0">
          {t['howiwork.eyebrow']}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-ink-primary/10">
        {principles.map((p) => (
          <article class="p-8 lg:p-10">
            <p class="font-mono text-sm font-bold text-brand-primary m-0" aria-hidden="true">
              {p.mark}
            </p>
            <h3 class="font-sans text-xl font-bold text-ink-primary m-0 mt-4 mb-2 leading-tight">
              {p.title}
            </h3>
            <p class="text-body-medium text-ink-muted leading-relaxed m-0">
              {p.body}
            </p>
          </article>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-8 lg:px-10 py-5 bg-brand-primary text-brand-primary-foreground">
        <p data-speakable class="font-sans text-base font-bold m-0">
          {t['whycurfee.conclusion']}
        </p>
        <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-brand-primary-foreground/70 m-0">
          {t['whycurfee.conclusion.label']}
        </p>
      </div>

    </div>

  </div>
</section>
