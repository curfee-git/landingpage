---
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

// Three levels, ordered from strictest (the system decides) to human judgment.
const levels = [
  {
    mark: '01',
    title: t['decide.1.title'],
    body: t['decide.1.body'],
    examples: [t['decide.1.example.1'], t['decide.1.example.2'], t['decide.1.example.3']],
  },
  {
    mark: '02',
    title: t['decide.2.title'],
    body: t['decide.2.body'],
    examples: [t['decide.2.example.1'], t['decide.2.example.2'], t['decide.2.example.3']],
  },
  {
    mark: '03',
    title: t['decide.3.title'],
    body: t['decide.3.body'],
    examples: [t['decide.3.example.1'], t['decide.3.example.2'], t['decide.3.example.3']],
  },
];
---

<section
  id="method"
  class="section-pad bg-surface-soft"
  aria-labelledby="method-heading"
>
  {/* Legacy anchors: external links to /#why-curfee keep landing here */}
  <div id="why-curfee" aria-hidden="true"></div>
  <div class="max-w-300 mx-auto px-gutter xl:px-0">

    <header class="max-w-184 mb-12 lg:mb-16">
      <p class="text-eyebrow text-brand-primary m-0">
        {t['decide.eyebrow']}
      </p>
      <h2
        id="method-heading"
        data-speakable
        class="font-sans text-3xl md:text-4xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto m-0 mt-6"
      >
        {t['decide.heading']}
      </h2>
    </header>

    <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 m-0 p-0 list-none" role="list">
      {levels.map((level) => (
        <li class="flex flex-col p-8 lg:p-10 bg-white rounded-xl">
          <p class="font-mono text-xl lg:text-2xl font-bold text-brand-primary m-0" aria-hidden="true">
            {level.mark}
          </p>
          <h3 class="font-sans text-xl font-bold text-ink-primary m-0 mt-4">
            {level.title}
          </h3>
          <p class="text-body-medium text-ink-muted leading-relaxed m-0 mt-2 mb-6">
            {level.body}
          </p>
          <div class="mt-auto">
            <h4 class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-meta m-0">
              {t['decide.examples.label']}
            </h4>
            <ul class="m-0 mt-3 p-0 list-none flex flex-col gap-2.5" role="list">
              {level.examples.map((example) => (
                <li class="flex items-center gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-primary shrink-0" aria-hidden="true"></span>
                  <span class="font-sans text-sm font-medium text-ink-primary/75">{example}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>

  </div>
</section>
