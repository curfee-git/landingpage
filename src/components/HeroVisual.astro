---
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

// Flat-top hexagon around (cx, cy) with outer radius r, as an SVG points string.
function hex(cx: number, cy: number, r: number): string {
  const h = r * 0.866;
  return [
    [cx + r, cy],
    [cx + r / 2, cy + h],
    [cx - r / 2, cy + h],
    [cx - r, cy],
    [cx - r / 2, cy - h],
    [cx + r / 2, cy - h],
  ]
    .map(([x, y]) => `${x},${Math.round(y * 10) / 10}`)
    .join(' ');
}

const BUS_X = 240;
const HEX_R = 28;
const CORE_R = 10.5;
const EDGE = HEX_R * 0.866; // distance from centre to the flat top/bottom edge
const STEP = 84; // vertical distance between stacked modules

// Six domains with two modules each, three domains per side of the bus.
// Inside a domain the modules are wired directly and in both directions (high
// cohesion); outward they talk to the bus only (low coupling).
const groups = [
  { x: 28, y: 40, side: 'left', label: t['hero.visual.group.1'], modules: [t['hero.visual.module.1'], t['hero.visual.module.2']] },
  { x: 276, y: 40, side: 'right', label: t['hero.visual.group.2'], modules: [t['hero.visual.module.3'], t['hero.visual.module.4']] },
  { x: 28, y: 260, side: 'left', label: t['hero.visual.group.3'], modules: [t['hero.visual.module.5'], t['hero.visual.module.6']] },
  { x: 276, y: 260, side: 'right', label: t['hero.visual.group.4'], modules: [t['hero.visual.module.7'], t['hero.visual.module.8']] },
  { x: 28, y: 480, side: 'left', label: t['hero.visual.group.5'], modules: [t['hero.visual.module.9'], t['hero.visual.module.10']] },
  { x: 276, y: 480, side: 'right', label: t['hero.visual.group.6'], modules: [t['hero.visual.module.11'], t['hero.visual.module.12']] },
];
const groupHeight = (g: (typeof groups)[number]) => 112 + (g.modules.length - 1) * STEP;
const hexX = (g: (typeof groups)[number]) => (g.side === 'left' ? g.x + 124 : g.x + 52);

interface Node {
  cx: number;
  cy: number;
  name: string;
  dir: 1 | -1; // 1: bus lies to the right of the module, -1: bus lies to the left
}
const nodes: Node[] = groups.flatMap((g) =>
  g.modules.map((name, i) => ({
    cx: hexX(g),
    cy: g.y + 66 + i * STEP,
    name,
    dir: g.side === 'left' ? 1 : -1,
  }))
);

// Direct, bidirectional links between the stacked modules of a domain.
const links = groups.flatMap((g) =>
  g.modules.slice(1).map((_, i) => ({
    cx: hexX(g),
    y1: g.y + 66 + i * STEP,
    y2: g.y + 66 + (i + 1) * STEP,
  }))
);
---

<div class="hero-visual w-full max-w-125" role="img" aria-label={t['hero.visual.aria']}>
  <div aria-hidden="true">

    <svg viewBox="20 16 440 676" class="block w-full h-auto">
      <defs>
        <marker id="ah-round" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
          <path d="M1.5 1.5L8.5 5L1.5 8.5Z" class="fill-brand-primary/45 stroke-brand-primary/45" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
        </marker>
      </defs>

      {/* The vertical event bus, the only road between the domains */}
      <line x1={BUS_X} y1="44" x2={BUS_X} y2="688" class="stroke-ink-primary/20" stroke-width="1.5" stroke-linecap="round" />
      <text x={BUS_X} y="32" text-anchor="middle" class="font-mono text-[9px] font-bold uppercase tracking-[0.12em] fill-ink-primary/40">{t['hero.visual.bus']}</text>

      {/* Domains */}
      {groups.map((g) => (
        <g>
          <rect x={g.x} y={g.y} width="176" height={groupHeight(g)} rx="10" class="fill-brand-primary/3 stroke-ink-primary/15 [stroke-dasharray:4_3]" stroke-width="1" />
          <text x={g.x + 12} y={g.y + 20} class="font-mono text-[9px] font-bold uppercase tracking-[0.12em] fill-ink-primary/50">{g.label}</text>
        </g>
      ))}

      {/* High cohesion: the modules of a domain are wired directly, one lane per direction,
          in the same language as the event lines */}
      {links.map((l) => (
        <g>
          <line
            x1={l.cx - 7} y1={l.y1 + EDGE + 5}
            x2={l.cx - 7} y2={l.y2 - EDGE - 5}
            class="stroke-brand-primary/40" stroke-width="1" stroke-linecap="round" marker-end="url(#ah-round)"
          />
          <line
            x1={l.cx + 7} y1={l.y2 - EDGE - 5}
            x2={l.cx + 7} y2={l.y1 + EDGE + 6}
            class="stroke-brand-primary/40" stroke-width="1" stroke-linecap="round" marker-end="url(#ah-round)"
          />
        </g>
      ))}

      {/* Low coupling: one publish and one subscribe line per module, to the bus and nowhere else */}
      {nodes.map((n) => (
        <g>
          <line
            x1={n.cx + n.dir * 31} y1={n.cy - 7}
            x2={BUS_X - n.dir * 5} y2={n.cy - 7}
            class="stroke-brand-primary/40" stroke-width="1" stroke-linecap="round" marker-end="url(#ah-round)"
          />
          <line
            x1={BUS_X - n.dir * 5} y1={n.cy + 7}
            x2={n.cx + n.dir * 32} y2={n.cy + 7}
            class="stroke-brand-primary/40" stroke-width="1" stroke-linecap="round" marker-end="url(#ah-round)"
          />
        </g>
      ))}

      {/* Modules: hexagon, centred domain core, ports, name on the outer side */}
      {nodes.map((n) => (
        <g>
          <polygon points={hex(n.cx, n.cy, HEX_R)} class="fill-white stroke-ink-primary/30" stroke-width="1.25" stroke-linejoin="round" />
          <polygon points={hex(n.cx, n.cy, CORE_R)} class="fill-brand-primary/10 stroke-brand-primary/30" stroke-width="1" stroke-linejoin="round" />
          <circle cx={n.cx + n.dir * 24} cy={n.cy - 7} r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
          <circle cx={n.cx + n.dir * 24} cy={n.cy + 7} r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
          <text
            x={n.cx - n.dir * 36}
            y={n.cy + 3}
            text-anchor={n.dir === 1 ? 'end' : 'start'}
            class="font-mono text-[9px] font-bold fill-ink-primary/80"
          >{n.name}</text>
        </g>
      ))}

      {/* Ports on the domain links, one pair per lane */}
      {links.map((l) => (
        <g>
          <circle cx={l.cx - 7} cy={l.y1 + EDGE} r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
          <circle cx={l.cx + 7} cy={l.y1 + EDGE} r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
          <circle cx={l.cx - 7} cy={l.y2 - EDGE} r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
          <circle cx={l.cx + 7} cy={l.y2 - EDGE} r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
        </g>
      ))}

      {/* Events travelling over the bus; hidden when reduced motion is preferred */}
      <g class="motion-reduce:hidden">
        <circle r="2.5" class="fill-brand-primary/55">
          <animateMotion dur="5s" repeatCount="indefinite" path="M297 183 L240 183 L240 333 L183 333" />
        </circle>
        <circle r="2.5" class="fill-brand-primary/55">
          <animateMotion dur="4.5s" begin="1.6s" repeatCount="indefinite" path="M297 403 L240 403 L240 637 L183 637" />
        </circle>
        <circle r="2.5" class="fill-brand-primary/55">
          <animateMotion dur="3.5s" begin="3s" repeatCount="indefinite" path="M183 99 L240 99 L240 113 L297 113" />
        </circle>
      </g>

      {/* Violation: the tempting shortcut. The cart calls pricing across the bus directly,
          but that crosses two domains, so it dies at the module boundary. */}
      <path d="M306 124C272 146 212 152 182 168" class="stroke-brand-error fill-none [stroke-dasharray:5_4]" stroke-width="1.5" stroke-linecap="round" />
      <g class="stroke-brand-error" stroke-width="2" stroke-linecap="round">
        <line x1="171" y1="163" x2="181" y2="173" />
        <line x1="181" y1="163" x2="171" y2="173" />
      </g>
    </svg>

  </div>
</div>
