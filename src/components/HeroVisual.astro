---
import Icon from '@/components/shared/Icon.astro';
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

const disciplineRows = [
  t['hero.visual.row.1'],
  t['hero.visual.row.2'],
  t['hero.visual.row.3'],
  t['hero.visual.row.4'],
  t['hero.visual.row.5'],
];

const fiveStrands = [
  { from: 40, to: 110 },
  { from: 110, to: 145 },
  { from: 180, to: 180 },
  { from: 250, to: 215 },
  { from: 320, to: 250 },
];

const threeStrands = [
  { from: 130, to: 156 },
  { from: 180, to: 180 },
  { from: 230, to: 204 },
];
---

<div class="hero-visual relative w-full max-w-105" role="img" aria-label={t['hero.visual.aria']}>

  <div class="absolute -inset-6 rounded-lg bg-brand-primary/4" aria-hidden="true"></div>

  <div aria-hidden="true" class="relative bg-white border border-ink-primary/13 rounded-lg p-5 sm:p-6 shadow-[0_1px_3px_rgb(var(--ink-primary)/0.08),0_12px_32px_rgb(var(--ink-primary)/0.07)]">

    <div class="border border-ink-primary/13 rounded-md p-3">
      <p class="m-0 text-right font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-meta">{t['hero.visual.badge.discipline']}</p>

      <div class="mt-3 flex flex-wrap justify-center gap-2">
        {disciplineRows.map((row) => (
          <span class="inline-flex items-center gap-2 bg-surface-base rounded-md px-3 py-2">
            <Icon name="autorenew" class="w-3.5 h-3.5 text-ink-meta shrink-0" />
            <span class="font-sans text-[0.8125rem] font-medium text-ink-muted whitespace-nowrap">{row}</span>
          </span>
        ))}
      </div>
    </div>

    <svg viewBox="0 0 360 48" class="block w-full h-auto text-ink-primary/25" aria-hidden="true" fill="none">
      {fiveStrands.map(({ from, to }) => (
        <path d={`M${from} 0C${from} 30 ${to} 24 ${to} 48`} stroke="currentColor" stroke-width="1.5" />
      ))}
    </svg>

    <div class="flex justify-center">
      <span class="border border-brand-primary/15 bg-brand-primary/8 rounded-md px-4 py-2 text-center font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-brand-primary">{t['hero.visual.reduce']}</span>
    </div>

    <svg viewBox="0 0 360 40" class="block w-full h-auto text-brand-primary/45" aria-hidden="true" fill="none">
      {threeStrands.map(({ from, to }) => (
        <path d={`M${from} 0C${from} 25 ${to} 19 ${to} 40`} stroke="currentColor" stroke-width="1.5" />
      ))}
    </svg>

    <div class="flex justify-center">
      <span class="border border-brand-primary/15 bg-brand-primary/8 rounded-md px-4 py-2 text-center font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-brand-primary">{t['hero.visual.embed']}</span>
    </div>

    <svg viewBox="0 0 360 36" class="block w-full h-auto text-brand-primary" aria-hidden="true" fill="none">
      <path d="M180 7v15" stroke="currentColor" stroke-width="1.5" />
      <path d="M175.5 21.5h9L180 28.5z" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
    </svg>

    <div class="border border-brand-primary/25 bg-brand-primary/4 rounded-md p-3">
      <div class="flex items-center gap-2.5 bg-brand-primary text-brand-primary-foreground rounded-md px-3.5 py-3">
        <svg viewBox="0 0 16 16" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.5"/></svg>
        <span class="font-sans text-sm font-bold">{t['hero.visual.takeover']}</span>
      </div>
      <p class="flex justify-end m-0 mt-3 pr-0.5">
        <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-brand-primary">{t['hero.visual.result']}</span>
      </p>
    </div>

  </div>

</div>
