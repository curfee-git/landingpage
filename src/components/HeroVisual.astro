---
import Icon from '@/components/shared/Icon.astro';
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

const disciplineRows = [
  t['hero.visual.row.1'],
  t['hero.visual.row.2'],
  t['hero.visual.row.3'],
  t['hero.visual.row.4'],
  t['hero.visual.row.5'],
];

const steps = [
  t['hero.visual.reduce'],
  t['hero.visual.embed'],
];
---

<div class="hero-visual relative w-full max-w-105" role="img" aria-label={t['hero.visual.aria']}>

  <div class="absolute -inset-6 rounded-lg bg-brand-primary/4" aria-hidden="true"></div>

  <div aria-hidden="true" class="relative bg-white border border-ink-primary/13 rounded-lg p-5 sm:p-6 shadow-[0_1px_3px_rgb(var(--ink-primary)/0.08),0_12px_32px_rgb(var(--ink-primary)/0.07)]">

    <div class="relative border border-ink-primary/13 rounded-md p-3 pt-9">
      <span class="absolute top-3 right-3.5 font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-meta">{t['hero.visual.badge.discipline']}</span>
      <ul class="flex flex-col gap-2 m-0 p-0 list-none">
        {disciplineRows.map((row) => (
          <li class="flex items-center gap-2.5 bg-surface-base rounded-md px-3.5 py-2.5">
            <Icon name="autorenew" class="w-3.5 h-3.5 text-ink-meta shrink-0" />
            <span class="font-sans text-sm font-medium text-ink-muted">{row}</span>
          </li>
        ))}
      </ul>
    </div>

    {steps.map((step) => (
      <>
        <div class="flex justify-center py-1.5">
          <svg viewBox="0 0 16 22" class="w-3.5 h-[1.2rem] text-brand-primary/50" aria-hidden="true"><path d="M8 2v12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M4.7 13.6h6.6L8 18.8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </div>
        <div class="border border-brand-primary/15 bg-brand-primary/8 rounded-md px-4 py-2.5 text-center">
          <span class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-brand-primary">{step}</span>
        </div>
      </>
    ))}

    <div class="flex justify-center py-1.5">
      <svg viewBox="0 0 16 22" class="w-3.5 h-[1.2rem] text-brand-primary/50" aria-hidden="true"><path d="M8 2v12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M4.7 13.6h6.6L8 18.8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
    </div>

    <div class="border border-brand-primary/25 bg-brand-primary/4 rounded-md p-3">
      <div class="flex items-center gap-2.5 bg-brand-primary text-brand-primary-foreground rounded-md px-3.5 py-3">
        <svg viewBox="0 0 16 16" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.5"/></svg>
        <span class="font-sans text-sm font-bold">{t['hero.visual.takeover']}</span>
      </div>
      <p class="flex justify-end m-0 mt-3 pr-0.5">
        <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-brand-primary">{t['hero.visual.result']}</span>
      </p>
    </div>

  </div>

</div>
