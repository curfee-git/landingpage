---
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;
---

{/* TODO(philipp): Beispiel-Snippet durch eine echte Regel samt echter CI-Ausgabe aus einem
    Engagement ersetzen (Tool, Regelname, Meldung). Bis dahin trägt das Artefakt das
    Beispiel-Badge oben rechts. */}
<div class="hero-visual relative w-full max-w-105" role="img" aria-label={t['hero.visual.aria']}>

  <div class="absolute -inset-6 rounded-lg bg-brand-primary/4" aria-hidden="true"></div>

  <div aria-hidden="true" class="relative bg-white border border-ink-primary/13 rounded-lg p-5 sm:p-6 shadow-[0_1px_3px_rgb(var(--ink-primary)/0.08),0_12px_32px_rgb(var(--ink-primary)/0.07)]">

    <div class="flex items-center justify-between gap-3">
      <p class="m-0 font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-meta">{t['hero.visual.rule']}</p>
      <p class="m-0 inline-flex items-center font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-brand-primary border border-brand-primary/25 bg-brand-primary/4 rounded-full px-2.5 py-0.5">{t['hero.visual.example']}</p>
    </div>

    <pre
      class="m-0 mt-3 overflow-x-auto font-mono text-[0.7rem] sm:text-[0.76rem] leading-[1.7] text-ink-primary/85"><code><span class="text-brand-primary">@ArchTest</span>
<span class="text-ink-meta">static final</span> ArchRule domain_stays_clean =
    noClasses().that()
        .resideInAPackage(<span class="text-brand-primary">"..domain.."</span>)
        .should().dependOnClassesThat()
        .resideInAPackage(<span class="text-brand-primary">"..infrastructure.."</span>);</code></pre>

    <p class="m-0 mt-5 font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-meta">{t['hero.visual.output']}</p>

    <pre
      class="m-0 mt-3 overflow-x-auto font-mono text-[0.7rem] sm:text-[0.76rem] leading-[1.7] text-ink-primary/85"><code><span class="font-bold text-brand-error">✗ ArchitectureTest » domain_stays_clean</span>
  Field &lt;OrderService.repo&gt; depends on
  &lt;JdbcOrderRepository&gt; <span class="text-ink-meta">(OrderService.java:24)</span>

<span class="font-bold text-brand-error">1 rule violated · merge blocked</span></code></pre>

  </div>

</div>
