---
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

// Flat-top hexagon around (cx, cy) with outer radius r, as an SVG points string.
function hex(cx: number, cy: number, r: number): string {
  const h = r * 0.866;
  return [
    [cx + r, cy],
    [cx + r / 2, cy + h],
    [cx - r / 2, cy + h],
    [cx - r, cy],
    [cx - r / 2, cy - h],
    [cx + r / 2, cy - h],
  ]
    .map(([x, y]) => `${x},${Math.round(y * 10) / 10}`)
    .join(' ');
}

const BUS_Y = 252;
const HEX_R = 28;
const CORE_R = 10.5;
const EDGE = HEX_R * 0.866; // vertical distance from centre to the flat top/bottom edge

// Six domains, two hexagonal modules each, three above and three below the bus.
// Inside a domain the modules are wired directly (high cohesion); outward they
// talk to the bus only (low coupling).
const groups = [
  { x: 52, y: 64, side: 'top', label: t['hero.visual.group.1'], modules: [t['hero.visual.module.1'], t['hero.visual.module.2']] },
  { x: 272, y: 64, side: 'top', label: t['hero.visual.group.2'], modules: [t['hero.visual.module.3'], t['hero.visual.module.4']] },
  { x: 492, y: 64, side: 'top', label: t['hero.visual.group.3'], modules: [t['hero.visual.module.5'], t['hero.visual.module.6']] },
  { x: 52, y: 300, side: 'bottom', label: t['hero.visual.group.4'], modules: [t['hero.visual.module.7'], t['hero.visual.module.8']] },
  { x: 272, y: 300, side: 'bottom', label: t['hero.visual.group.5'], modules: [t['hero.visual.module.9'], t['hero.visual.module.10']] },
  { x: 492, y: 300, side: 'bottom', label: t['hero.visual.group.6'], modules: [t['hero.visual.module.11'], t['hero.visual.module.12']] },
];

interface Node {
  cx: number;
  cy: number;
  name: string;
  dir: 1 | -1; // 1: bus lies below the module, -1: bus lies above
}
const nodes: Node[] = groups.flatMap((g) => {
  const cy = g.side === 'top' ? g.y + 94 : g.y + 48;
  const dir: 1 | -1 = g.side === 'top' ? 1 : -1;
  return g.modules.map((name, i) => ({ cx: g.x + 56 + i * 84, cy, name, dir }));
});
---

<div class="hero-visual w-full max-w-200" role="img" aria-label={t['hero.visual.aria']}>
  <div aria-hidden="true">

    <svg viewBox="30 54 680 400" class="block w-full h-auto">
      <defs>
        <marker id="ah-round" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
          <path d="M1.5 1.5L8.5 5L1.5 8.5Z" class="fill-brand-primary/45 stroke-brand-primary/45" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
        </marker>
        <marker id="ah-round-strong" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
          <path d="M1.5 1.5L8.5 5L1.5 8.5Z" class="fill-brand-primary/70 stroke-brand-primary/70" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
        </marker>
      </defs>

      {/* The horizontal event bus, the only road between the domains */}
      <line x1="40" y1={BUS_Y} x2="700" y2={BUS_Y} class="stroke-ink-primary/20" stroke-width="1.5" stroke-linecap="round" />
      <text x="700" y={BUS_Y - 10} text-anchor="end" class="font-mono text-[9px] font-bold uppercase tracking-[0.12em] fill-ink-primary/40">{t['hero.visual.bus']}</text>

      {/* Domains */}
      {groups.map((g) => (
        <g>
          <rect x={g.x} y={g.y} width="196" height="140" rx="10" class="fill-brand-primary/3 stroke-ink-primary/15 [stroke-dasharray:4_3]" stroke-width="1" />
          <text x={g.x + 12} y={g.side === 'top' ? g.y + 24 : g.y + 126} class="font-mono text-[9px] font-bold uppercase tracking-[0.12em] fill-ink-primary/50">{g.label}</text>
        </g>
      ))}

      {/* High cohesion: the two modules of a domain are wired directly */}
      {groups.map((g) => {
        const cy = g.side === 'top' ? g.y + 94 : g.y + 48;
        return (
          <line x1={g.x + 90} y1={cy} x2={g.x + 105} y2={cy} class="stroke-brand-primary/70" stroke-width="1.25" stroke-linecap="round" marker-end="url(#ah-round-strong)" />
        );
      })}

      {/* Low coupling: one publish and one subscribe line per module, to the bus and nowhere else */}
      {nodes.map((n) => (
        <g>
          <line
            x1={n.cx - 7} y1={n.cy + n.dir * (EDGE + 5)}
            x2={n.cx - 7} y2={BUS_Y - n.dir * 5}
            class="stroke-brand-primary/40" stroke-width="1" stroke-linecap="round" marker-end="url(#ah-round)"
          />
          <line
            x1={n.cx + 7} y1={BUS_Y - n.dir * 5}
            x2={n.cx + 7} y2={n.cy + n.dir * (EDGE + 6)}
            class="stroke-brand-primary/40" stroke-width="1" stroke-linecap="round" marker-end="url(#ah-round)"
          />
        </g>
      ))}

      {/* Modules: hexagon, centred domain core, ports, name */}
      {nodes.map((n) => (
        <g>
          <polygon points={hex(n.cx, n.cy, HEX_R)} class="fill-white stroke-ink-primary/30" stroke-width="1.25" stroke-linejoin="round" />
          <polygon points={hex(n.cx, n.cy, CORE_R)} class="fill-brand-primary/10 stroke-brand-primary/30" stroke-width="1" stroke-linejoin="round" />
          <circle cx={n.cx - 7} cy={n.cy + n.dir * EDGE} r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
          <circle cx={n.cx + 7} cy={n.cy + n.dir * EDGE} r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
          <text x={n.cx} y={n.dir === 1 ? n.cy - 46 : n.cy + 54} text-anchor="middle" class="font-mono text-[9px] font-bold fill-ink-primary/80">{n.name}</text>
        </g>
      ))}

      {/* Ports on the domain link */}
      {groups.map((g) => {
        const cy = g.side === 'top' ? g.y + 94 : g.y + 48;
        return (
          <g>
            <circle cx={g.x + 84} cy={cy} r="3" class="fill-white stroke-brand-primary/55" stroke-width="1.1" />
            <circle cx={g.x + 112} cy={cy} r="3" class="fill-white stroke-brand-primary/55" stroke-width="1.1" />
          </g>
        );
      })}

      {/* Events travelling over the bus; hidden when reduced motion is preferred */}
      <g class="motion-reduce:hidden">
        <circle r="2.5" class="fill-brand-primary/55">
          <animateMotion dur="5s" repeatCount="indefinite" path="M405 187 L405 252 L115 252 L115 318" />
        </circle>
        <circle r="2.5" class="fill-brand-primary/55">
          <animateMotion dur="4s" begin="1.6s" repeatCount="indefinite" path="M541 187 L541 252 L419 252 L419 318" />
        </circle>
        <circle r="2.5" class="fill-brand-primary/55">
          <animateMotion dur="3.5s" begin="3s" repeatCount="indefinite" path="M185 318 L185 252 L335 252 L335 318" />
        </circle>
      </g>

      {/* Violation: the tempting shortcut. The cart calls pricing next door directly,
          but that crosses two domains, so it dies at the module boundary. */}
      <path d="M310 176C280 206 242 206 216 182" class="stroke-brand-error fill-none [stroke-dasharray:5_4]" stroke-width="1.5" stroke-linecap="round" />
      <g class="stroke-brand-error" stroke-width="2" stroke-linecap="round">
        <line x1="208" y1="169" x2="218" y2="179" />
        <line x1="218" y1="169" x2="208" y2="179" />
      </g>
    </svg>

  </div>
</div>
