---
import type { Translations } from '@/i18n/translations';
import { getRoutes } from '@/configurations/routes';
import HeroVisual from '@/components/HeroVisual.astro';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;
const routes = getRoutes(Astro.currentLocale);
---

<section
  id="hero"
  class="py-24"
  aria-labelledby="hero-heading"
>
  <div class="w-full max-w-300 mx-auto px-gutter xl:px-0">
    <div class="flex flex-col gap-10 md:gap-12 lg:flex-row lg:items-center lg:gap-16 xl:gap-20">

      <div class="max-w-230 lg:flex-[1.2] lg:min-w-0">
        <p class="text-eyebrow text-brand-primary m-0 mb-6">
          {t['hero.eyebrow']}
        </p>

        <h1
          id="hero-heading"
          data-speakable
          class="font-sans text-3xl sm:text-4xl md:text-5xl lg:text-4xl xl:text-5xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-manual m-0"
        >
          <Fragment set:html={t['hero.heading']} />
        </h1>

        <p
          data-speakable
          class="text-base lg:text-lg xl:text-xl text-ink-muted max-w-160 font-medium leading-relaxed mt-6 lg:mt-8 xl:mt-10"
          set:html={t['hero.subtitle']}
        />

        <div class="mt-8 lg:mt-10 xl:mt-12 flex flex-wrap items-center gap-4">
          <a
            href={routes.contact}
            class="inline-flex items-center justify-center gap-2 px-8 py-4 font-sans text-base font-bold rounded-md no-underline whitespace-nowrap border-2 cursor-pointer transition-all duration-200 bg-brand-primary text-brand-primary-foreground border-brand-primary hover:bg-brand-primary-hover hover:border-brand-primary-hover hover:-translate-y-0.5"
          >
            {t['hero.cta']}
          </a>
        </div>
      </div>

      <div class="flex lg:flex-[0.8] min-w-0 justify-center lg:justify-end">
        <HeroVisual translations={t} />
      </div>

    </div>
  </div>
</section>
