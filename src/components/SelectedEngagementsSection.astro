---
import { getTranslations } from '@/i18n/translations';

const t = getTranslations(Astro.currentLocale);

interface Engagement {
  mark: string;
  title: string;
  body: string;
  aria: string;
}

const engagements: Engagement[] = [
  {
    mark: '01',
    title: t['engagements.1.title'],
    body: t['engagements.1.body'],
    aria: t['engagements.1.diagram.aria'],
  },
  {
    mark: '02',
    title: t['engagements.2.title'],
    body: t['engagements.2.body'],
    aria: t['engagements.2.diagram.aria'],
  },
  {
    mark: '03',
    title: t['engagements.3.title'],
    body: t['engagements.3.body'],
    aria: t['engagements.3.diagram.aria'],
  },
  {
    mark: '04',
    title: t['engagements.4.title'],
    body: t['engagements.4.body'],
    aria: t['engagements.4.diagram.aria'],
  },
];
---

<section
  id="selected-engagements"
  class="section-pad bg-surface-soft"
  aria-labelledby="selected-engagements-heading"
>
  <div class="max-w-300 mx-auto px-gutter xl:px-0">
    <header class="max-w-184 mb-16 lg:mb-20">
      <p class="text-eyebrow text-brand-primary m-0">
        {t['engagements.eyebrow']}
      </p>
      <h2
        id="selected-engagements-heading"
        data-speakable
        class="font-sans text-3xl md:text-4xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto m-0 mt-6"
      >
        {t['engagements.heading']}
      </h2>
    </header>

    <div class="flex flex-col gap-20 lg:gap-28">
      {engagements.map((e, i) => (
        <article class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16 items-center">

          <div class={`lg:col-span-7 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
            <p class="font-mono text-xl lg:text-2xl font-bold text-brand-primary m-0" aria-hidden="true">
              {e.mark}
            </p>
            <h3 class="font-sans text-2xl font-bold leading-tight tracking-tight text-pretty break-words m-0 mt-4 text-ink-primary">
              {e.title}
            </h3>
            <p class="font-sans text-lg leading-relaxed text-ink-muted m-0 mt-5 max-w-[62ch]">
              {e.body}
            </p>
          </div>

          <div class={`lg:col-span-5 flex justify-center ${i % 2 === 1 ? 'lg:order-1 lg:justify-start' : 'lg:justify-end'}`}>
            <div
              class="w-full max-w-105 bg-white border border-ink-primary/13 rounded-lg p-5 sm:p-6 shadow-[0_1px_3px_rgb(var(--ink-primary)/0.08),0_12px_32px_rgb(var(--ink-primary)/0.07)]"
              role="img"
              aria-label={e.aria}
            >
              <div aria-hidden="true">

                {i === 0 && (
                  <div class="flex flex-col">
                    <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-meta m-0 mb-3">
                      {t['engagements.1.diagram.room']}
                    </p>

                    <div class="flex gap-3">
                      <span class="font-mono text-[0.65rem] font-bold text-ink-meta w-9 shrink-0 -mt-2">09:00</span>
                      <div class="flex-1 border-t border-ink-primary/13 py-1.5">
                        <div class="flex gap-1.5 h-16">
                          <div class="flex-1 min-w-0 flex items-center bg-surface-base rounded-md px-3">
                            <span class="font-sans text-sm font-medium text-ink-muted truncate">{t['engagements.1.diagram.booked']}</span>
                          </div>
                          <div class="flex-1 min-w-0 flex flex-col justify-center bg-brand-error/8 border border-brand-error/25 rounded-md px-3">
                            <span class="block font-sans text-sm font-medium text-brand-error line-through truncate">{t['engagements.1.diagram.conflict']}</span>
                            <span class="flex items-center gap-1 mt-0.5">
                              <svg viewBox="0 0 16 16" class="w-3 h-3 shrink-0 text-brand-error" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8"/></svg>
                              <span class="font-sans text-xs font-bold text-brand-error">{t['engagements.1.diagram.refused']}</span>
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="flex gap-3">
                      <span class="font-mono text-[0.65rem] font-bold text-ink-meta w-9 shrink-0 -mt-2">10:00</span>
                      <div class="flex-1 border-t border-ink-primary/13 py-1.5">
                        <div class="h-16 flex items-center px-3">
                          <span class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.08em] text-ink-primary/30">{t['engagements.1.diagram.free']}</span>
                        </div>
                      </div>
                    </div>

                    <div class="flex gap-3">
                      <span class="font-mono text-[0.65rem] font-bold text-ink-meta w-9 shrink-0 -mt-2">11:00</span>
                      <div class="flex-1 border-t border-ink-primary/13 py-1.5">
                        <div class="h-16 flex items-center justify-between gap-3 bg-brand-primary text-brand-primary-foreground rounded-md px-3">
                          <span class="font-sans text-sm font-bold truncate">{t['engagements.1.diagram.new']}</span>
                          <span class="flex items-center gap-1.5 shrink-0">
                            <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.5"/></svg>
                            <span class="font-sans text-sm font-bold">{t['engagements.1.diagram.confirmed']}</span>
                          </span>
                        </div>
                      </div>
                    </div>

                    <div class="flex gap-3">
                      <span class="font-mono text-[0.65rem] font-bold text-ink-meta w-9 shrink-0 -mt-2">12:00</span>
                      <div class="flex-1 border-t border-ink-primary/13"></div>
                    </div>
                  </div>
                )}

                {i === 1 && (
                  <div class="flex flex-col">
                    <div class="border border-ink-primary/13 rounded-md p-3.5">
                      <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-meta m-0 mb-3">
                        {t['engagements.2.diagram.form.title']}
                      </p>
                      <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-2.5">
                          <span class="font-sans text-xs font-medium text-ink-soft w-12 shrink-0">{t['engagements.2.diagram.field.1']}</span>
                          <div class="flex-1"><div class="h-2 rounded-full bg-ink-primary/10 w-full"></div></div>
                        </div>
                        <div class="flex items-center gap-2.5">
                          <span class="font-sans text-xs font-medium text-ink-soft w-12 shrink-0">{t['engagements.2.diagram.field.2']}</span>
                          <div class="flex-1"><div class="h-2 rounded-full bg-ink-primary/10 w-1/2"></div></div>
                        </div>
                        <div class="flex items-center gap-2.5">
                          <span class="font-sans text-xs font-medium text-ink-soft w-12 shrink-0">{t['engagements.2.diagram.field.3']}</span>
                          <div class="flex-1"><div class="h-2 rounded-full bg-ink-primary/10 w-2/3"></div></div>
                        </div>
                      </div>
                    </div>
                    <div class="flex justify-center py-1.5">
                      <svg viewBox="0 0 16 22" class="w-3.5 h-[1.2rem] text-brand-primary/50"><path d="M8 2v12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M4.7 13.6h6.6L8 18.8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="border border-brand-primary/15 bg-brand-primary/8 rounded-md px-4 py-2 text-center">
                      <span class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-brand-primary">{t['engagements.2.diagram.step']}</span>
                    </div>
                    <div class="flex justify-center py-1.5">
                      <svg viewBox="0 0 16 22" class="w-3.5 h-[1.2rem] text-brand-primary/50"><path d="M8 2v12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M4.7 13.6h6.6L8 18.8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="flex items-center gap-3">
                      <div class="flex-1 bg-surface-base rounded-md px-3.5 py-2.5 text-center">
                        <span class="font-sans text-sm font-medium text-ink-muted">{t['engagements.2.diagram.check']}</span>
                      </div>
                      <svg viewBox="0 0 22 16" class="w-[1.2rem] h-3.5 shrink-0 text-brand-primary/50"><path d="M2 8h12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M13.6 4.7v6.6L18.8 8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                      <div class="flex items-center justify-center gap-2 shrink-0 bg-brand-primary text-brand-primary-foreground rounded-md px-4 py-2.5">
                        <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.5"/></svg>
                        <span class="font-sans text-sm font-bold">{t['engagements.2.diagram.publish']}</span>
                      </div>
                    </div>
                  </div>
                )}

                {i === 2 && (
                  <div class="flex flex-col">
                    <div class="border border-ink-primary/13 rounded-md p-3.5">
                      <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-meta m-0 mb-3">
                        {t['engagements.3.diagram.form.title']}
                      </p>
                      <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-2.5">
                          <span class="font-sans text-xs font-medium text-ink-soft w-14 shrink-0">{t['engagements.3.diagram.field.1']}</span>
                          <div class="flex-1"><div class="h-2 rounded-full bg-ink-primary/10 w-2/3"></div></div>
                        </div>
                        <div class="flex items-center gap-2.5">
                          <span class="font-sans text-xs font-medium text-ink-soft w-14 shrink-0">{t['engagements.3.diagram.field.2']}</span>
                          <div class="flex-1"><div class="h-2 rounded-full bg-ink-primary/10 w-full"></div></div>
                        </div>
                        <div class="flex items-center gap-2.5">
                          <span class="font-sans text-xs font-medium text-ink-soft w-14 shrink-0">{t['engagements.3.diagram.field.3']}</span>
                          <div class="flex-1"><div class="h-2 rounded-full bg-ink-primary/10 w-1/2"></div></div>
                        </div>
                      </div>
                    </div>
                    <div class="flex justify-center py-1.5">
                      <svg viewBox="0 0 16 22" class="w-3.5 h-[1.2rem] text-brand-primary/50"><path d="M8 2v12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M4.7 13.6h6.6L8 18.8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="border border-brand-primary/15 bg-brand-primary/8 rounded-md px-4 py-2 text-center">
                      <span class="font-mono text-xs font-bold uppercase tracking-[0.08em] text-brand-primary">{t['engagements.3.diagram.step']}</span>
                    </div>
                    <div class="flex justify-center py-1.5">
                      <svg viewBox="0 0 16 22" class="w-3.5 h-[1.2rem] text-brand-primary/50"><path d="M8 2v12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M4.7 13.6h6.6L8 18.8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="grid grid-cols-2 gap-2.5">
                      <div class="border border-brand-primary/25 bg-brand-primary/4 rounded-md p-3">
                        <div class="flex items-center justify-between mb-2.5">
                          <span class="font-sans text-xs font-bold text-ink-primary">{t['engagements.3.diagram.out.de']}</span>
                          <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 shrink-0 text-brand-primary" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.5"/></svg>
                        </div>
                        <div class="h-1.5 rounded-full bg-brand-primary/20 w-3/4 mb-1.5"></div>
                        <div class="h-1.5 rounded-full bg-ink-primary/10 w-full mb-1.5"></div>
                        <div class="h-1.5 rounded-full bg-ink-primary/10 w-2/3"></div>
                      </div>
                      <div class="border border-brand-primary/25 bg-brand-primary/4 rounded-md p-3">
                        <div class="flex items-center justify-between mb-2.5">
                          <span class="font-sans text-xs font-bold text-ink-primary">{t['engagements.3.diagram.out.en']}</span>
                          <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 shrink-0 text-brand-primary" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.5"/></svg>
                        </div>
                        <div class="h-1.5 rounded-full bg-brand-primary/20 w-3/4 mb-1.5"></div>
                        <div class="h-1.5 rounded-full bg-ink-primary/10 w-full mb-1.5"></div>
                        <div class="h-1.5 rounded-full bg-ink-primary/10 w-2/3"></div>
                      </div>
                    </div>
                  </div>
                )}

                {i === 3 && (
                  <div class="flex flex-col">
                    <div class="border border-ink-primary/13 rounded-md p-3.5">
                      <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em] text-ink-meta m-0 mb-3">
                        {t['engagements.4.diagram.title']}
                      </p>
                      <div class="flex flex-col gap-2">
                        <div class="flex items-center justify-between gap-3 bg-surface-base rounded-md px-3.5 py-2.5">
                          <span class="font-sans text-sm font-medium text-ink-muted truncate">{t['engagements.4.diagram.check.1']}</span>
                          <span class="flex items-center gap-1.5 shrink-0 text-brand-primary">
                            <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.5"/></svg>
                            <span class="font-sans text-xs font-bold">{t['engagements.4.diagram.passed']}</span>
                          </span>
                        </div>
                        <div class="flex items-center justify-between gap-3 bg-surface-base rounded-md px-3.5 py-2.5">
                          <span class="font-sans text-sm font-medium text-ink-muted truncate">{t['engagements.4.diagram.check.2']}</span>
                          <span class="flex items-center gap-1.5 shrink-0 text-brand-primary">
                            <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.5"/></svg>
                            <span class="font-sans text-xs font-bold">{t['engagements.4.diagram.passed']}</span>
                          </span>
                        </div>
                        <div class="flex items-center justify-between gap-3 bg-brand-error/8 border border-brand-error/25 rounded-md px-3.5 py-2.5">
                          <span class="font-sans text-sm font-medium text-brand-error truncate">{t['engagements.4.diagram.check.3']}</span>
                          <span class="flex items-center gap-1 shrink-0 text-brand-error">
                            <svg viewBox="0 0 16 16" class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8"/></svg>
                            <span class="font-sans text-xs font-bold">{t['engagements.4.diagram.failed']}</span>
                          </span>
                        </div>
                      </div>
                    </div>
                    <div class="flex justify-center py-1.5">
                      <svg viewBox="0 0 16 22" class="w-3.5 h-[1.2rem] text-brand-error/50"><path d="M8 2v12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M4.7 13.6h6.6L8 18.8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="flex items-center justify-center gap-2 border border-brand-error/25 bg-brand-error/8 rounded-md px-4 py-2.5">
                      <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 shrink-0 text-brand-error" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8"/></svg>
                      <span class="font-sans text-sm font-bold text-brand-error">{t['engagements.4.diagram.blocked']}</span>
                    </div>
                  </div>
                )}

              </div>
            </div>
          </div>

        </article>
      ))}
    </div>
  </div>
</section>
