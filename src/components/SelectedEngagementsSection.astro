---
import { getTranslations } from '@/i18n/translations';

const t = getTranslations(Astro.currentLocale);

// Flat-top hexagon around (cx, cy) with outer radius r, as an SVG points string.
function hex(cx: number, cy: number, r: number): string {
  const h = r * 0.866;
  return [
    [cx + r, cy],
    [cx + r / 2, cy + h],
    [cx - r / 2, cy + h],
    [cx - r, cy],
    [cx - r / 2, cy - h],
    [cx + r / 2, cy - h],
  ]
    .map(([x, y]) => `${x},${Math.round(y * 10) / 10}`)
    .join(' ');
}

interface Engagement {
  mark: string;
  title: string;
  body: string;
  aria: string;
}

const engagements: Engagement[] = [
  {
    mark: '01',
    title: t['engagements.1.title'],
    body: t['engagements.1.body'],
    aria: t['engagements.1.diagram.aria'],
  },
  {
    mark: '02',
    title: t['engagements.2.title'],
    body: t['engagements.2.body'],
    aria: t['engagements.2.diagram.aria'],
  },
  {
    mark: '03',
    title: t['engagements.3.title'],
    body: t['engagements.3.body'],
    aria: t['engagements.3.diagram.aria'],
  },
  {
    mark: '04',
    title: t['engagements.4.title'],
    body: t['engagements.4.body'],
    aria: t['engagements.4.diagram.aria'],
  },
];
---

<section
  id="selected-engagements"
  class="section-pad bg-surface-soft"
  aria-labelledby="selected-engagements-heading"
>
  <div class="max-w-300 mx-auto px-gutter xl:px-0">
    <header class="max-w-184 mb-16 lg:mb-20">
      <p class="text-eyebrow text-brand-primary m-0">
        {t['engagements.eyebrow']}
      </p>
      <h2
        id="selected-engagements-heading"
        data-speakable
        class="font-sans text-3xl md:text-4xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto m-0 mt-6"
      >
        {t['engagements.heading']}
      </h2>
    </header>

    {/* Shared arrowheads for the engagement diagrams, same language as the hero */}
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <defs>
        <marker id="eng-ah" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
          <path d="M1.5 1.5L8.5 5L1.5 8.5Z" class="fill-brand-primary/45 stroke-brand-primary/45" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
        </marker>
        <marker id="eng-ah-strong" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
          <path d="M1.5 1.5L8.5 5L1.5 8.5Z" class="fill-brand-primary/70 stroke-brand-primary/70" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
        </marker>
      </defs>
    </svg>

    <div class="flex flex-col gap-20 lg:gap-28">
      {engagements.map((e, i) => (
        <article class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16 items-center">

          <div class={`lg:col-span-7 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
            <p class="font-mono text-xl lg:text-2xl font-bold text-brand-primary m-0" aria-hidden="true">
              {e.mark}
            </p>
            <h3 class="font-sans text-2xl font-bold leading-tight tracking-tight text-pretty break-words m-0 mt-4 text-ink-primary">
              {e.title}
            </h3>
            <p class="font-sans text-lg leading-relaxed text-ink-muted m-0 mt-5 max-w-[62ch]">
              {e.body}
            </p>
          </div>

          <div class={`lg:col-span-5 flex justify-center ${i % 2 === 1 ? 'lg:order-1 lg:justify-start' : 'lg:justify-end'}`}>
            <div
              class="w-full max-w-105 bg-white border border-ink-primary/13 rounded-lg p-5 sm:p-6 shadow-[0_1px_3px_rgb(var(--ink-primary)/0.08),0_12px_32px_rgb(var(--ink-primary)/0.07)]"
              role="img"
              aria-label={e.aria}
            >
              <div aria-hidden="true">

                {i === 0 && (
                  <svg viewBox="0 0 360 200" class="block w-full h-auto">
                    <polygon points={hex(180, 56, 30)} class="fill-white stroke-ink-primary/30" stroke-width="1.25" stroke-linejoin="round" />
                    <polygon points={hex(180, 56, 11.5)} class="fill-brand-primary/10 stroke-brand-primary/30" stroke-width="1" stroke-linejoin="round" />
                    <text x="220" y="60" class="font-mono text-[10px] font-bold fill-ink-primary/80">{t['engagements.1.diagram.module']}</text>
                    <circle cx="168" cy="82" r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
                    <circle cx="192" cy="82" r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />

                    {/* The calendar track with the occupied block */}
                    <line x1="32" y1="160" x2="328" y2="160" class="stroke-ink-primary/20" stroke-width="1.5" stroke-linecap="round" />
                    <rect x="60" y="146" width="134" height="14" rx="3" class="fill-ink-primary/10" />
                    <text x="127" y="156" text-anchor="middle" class="font-mono text-[8px] font-bold uppercase tracking-[0.1em] fill-ink-primary/50">{t['engagements.1.diagram.occupied']}</text>
                    <text x="60" y="176" text-anchor="middle" class="font-mono text-[8px] font-medium fill-ink-primary/45">09:00</text>
                    <text x="127" y="176" text-anchor="middle" class="font-mono text-[8px] font-medium fill-ink-primary/45">10:00</text>
                    <text x="194" y="176" text-anchor="middle" class="font-mono text-[8px] font-medium fill-ink-primary/45">11:00</text>
                    <text x="261" y="176" text-anchor="middle" class="font-mono text-[8px] font-medium fill-ink-primary/45">12:00</text>

                    {/* Write into the free slot passes, write into the occupied slot dies */}
                    <path d="M192 88C210 110 222 126 227 140" class="stroke-brand-primary/40 fill-none" stroke-width="1" stroke-linecap="round" marker-end="url(#eng-ah)" />
                    <path d="M168 88C150 108 136 122 129 136" class="stroke-brand-error fill-none [stroke-dasharray:5_4]" stroke-width="1.5" stroke-linecap="round" />
                    <g class="stroke-brand-error" stroke-width="2" stroke-linecap="round">
                      <line x1="122" y1="138" x2="132" y2="148" />
                      <line x1="132" y1="138" x2="122" y2="148" />
                    </g>
                  </svg>
                )}

                {i === 1 && (
                  <svg viewBox="0 0 360 170" class="block w-full h-auto">
                    <rect x="16" y="62" width="76" height="42" rx="8" class="fill-surface-base stroke-ink-primary/20" stroke-width="1" />
                    <text x="54" y="86" text-anchor="middle" class="font-mono text-[10px] font-bold fill-ink-primary/70">{t['engagements.2.diagram.form']}</text>

                    <polygon points={hex(168, 83, 27)} class="fill-white stroke-ink-primary/30" stroke-width="1.25" stroke-linejoin="round" />
                    <polygon points={hex(168, 83, 10)} class="fill-brand-primary/10 stroke-brand-primary/30" stroke-width="1" stroke-linejoin="round" />
                    <text x="168" y="132" text-anchor="middle" class="font-mono text-[10px] font-bold fill-ink-primary/80">{t['engagements.2.diagram.import']}</text>

                    <polygon points={hex(300, 83, 27)} class="fill-white stroke-ink-primary/30" stroke-width="1.25" stroke-linejoin="round" />
                    <polygon points={hex(300, 83, 10)} class="fill-brand-primary/10 stroke-brand-primary/30" stroke-width="1" stroke-linejoin="round" />
                    <text x="300" y="132" text-anchor="middle" class="font-mono text-[10px] font-bold fill-ink-primary/80">{t['engagements.2.diagram.module']}</text>

                    {/* Valid JSON enters through the port, the import hands over to the portal */}
                    <text x="104" y="66" class="font-mono text-[8px] font-bold uppercase tracking-[0.1em] fill-ink-primary/40">{t['engagements.2.diagram.json']}</text>
                    <line x1="98" y1="76" x2="137" y2="76" class="stroke-brand-primary/40" stroke-width="1" stroke-linecap="round" marker-end="url(#eng-ah)" />
                    <circle cx="145" cy="76" r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
                    <line x1="201" y1="83" x2="265" y2="83" class="stroke-brand-primary/40" stroke-width="1" stroke-linecap="round" marker-end="url(#eng-ah)" />
                    <circle cx="195" cy="83" r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
                    <circle cx="273" cy="83" r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />

                    {/* Invalid submissions die at validation, before the import */}
                    <line x1="98" y1="96" x2="130" y2="96" class="stroke-brand-error [stroke-dasharray:5_4]" stroke-width="1.5" stroke-linecap="round" />
                    <g class="stroke-brand-error" stroke-width="2" stroke-linecap="round">
                      <line x1="135" y1="91" x2="145" y2="101" />
                      <line x1="145" y1="91" x2="135" y2="101" />
                    </g>
                    <text x="98" y="114" class="font-mono text-[8px] font-bold uppercase tracking-[0.1em] fill-brand-error/70">{t['engagements.2.diagram.invalid']}</text>
                  </svg>
                )}

                {i === 2 && (
                  <svg viewBox="0 0 360 190" class="block w-full h-auto">
                    {/* Page with translation: predefined fields, EN filled */}
                    <rect x="16" y="20" width="96" height="64" rx="8" class="fill-surface-base stroke-ink-primary/20" stroke-width="1" />
                    <rect x="28" y="32" width="56" height="6" rx="3" class="fill-ink-primary/15" />
                    <rect x="28" y="44" width="72" height="6" rx="3" class="fill-ink-primary/15" />
                    <rect x="28" y="60" width="44" height="6" rx="3" class="fill-brand-primary/30" />
                    <text x="78" y="67" class="font-mono text-[7px] font-bold fill-brand-primary/70">EN</text>

                    {/* Page without translation: EN empty */}
                    <rect x="16" y="106" width="96" height="64" rx="8" class="fill-surface-base stroke-ink-primary/20" stroke-width="1" />
                    <rect x="28" y="118" width="56" height="6" rx="3" class="fill-ink-primary/15" />
                    <rect x="28" y="130" width="72" height="6" rx="3" class="fill-ink-primary/15" />
                    <rect x="28" y="146" width="44" height="6" rx="3" class="fill-none stroke-brand-error/50 [stroke-dasharray:3_2]" stroke-width="1" />
                    <text x="78" y="153" class="font-mono text-[7px] font-bold fill-brand-error/70">EN?</text>

                    <polygon points={hex(288, 95, 32)} class="fill-white stroke-ink-primary/30" stroke-width="1.25" stroke-linejoin="round" />
                    <polygon points={hex(288, 95, 12)} class="fill-brand-primary/10 stroke-brand-primary/30" stroke-width="1" stroke-linejoin="round" />
                    <text x="288" y="146" text-anchor="middle" class="font-mono text-[10px] font-bold fill-ink-primary/80">{t['engagements.3.diagram.module']}</text>

                    <line x1="118" y1="50" x2="247" y2="76" class="stroke-brand-primary/40" stroke-width="1" stroke-linecap="round" marker-end="url(#eng-ah)" />
                    <circle cx="258" cy="79" r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />

                    <line x1="118" y1="138" x2="238" y2="112" class="stroke-brand-error [stroke-dasharray:5_4]" stroke-width="1.5" stroke-linecap="round" />
                    <g class="stroke-brand-error" stroke-width="2" stroke-linecap="round">
                      <line x1="242" y1="103" x2="252" y2="113" />
                      <line x1="252" y1="103" x2="242" y2="113" />
                    </g>
                  </svg>
                )}

                {i === 3 && (
                  <div class="flex flex-col">
                    <svg viewBox="0 0 360 150" class="block w-full h-auto">
                      <polygon points={hex(100, 78, 34)} class="fill-white stroke-ink-primary/30" stroke-width="1.25" stroke-linejoin="round" />
                      <polygon points={hex(100, 78, 13)} class="fill-brand-primary/10 stroke-brand-primary/30" stroke-width="1" stroke-linejoin="round" />
                      <text x="100" y="134" text-anchor="middle" class="font-mono text-[10px] font-bold fill-ink-primary/80">{t['engagements.4.diagram.api']}</text>

                      <polygon points={hex(280, 78, 34)} class="fill-white stroke-ink-primary/30" stroke-width="1.25" stroke-linejoin="round" />
                      <polygon points={hex(280, 78, 13)} class="fill-brand-primary/10 stroke-brand-primary/30" stroke-width="1" stroke-linejoin="round" />
                      <text x="280" y="134" text-anchor="middle" class="font-mono text-[10px] font-bold fill-ink-primary/80">{t['engagements.4.diagram.domain']}</text>

                      <text x="188" y="58" text-anchor="middle" class="font-mono text-[8px] font-bold uppercase tracking-[0.1em] fill-brand-primary/60">{t['hero.visual.contract']}</text>
                      <line x1="136" y1="71" x2="242" y2="71" class="stroke-brand-primary/70" stroke-width="1.25" stroke-linecap="round" marker-end="url(#eng-ah-strong)" />
                      <circle cx="130" cy="71" r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
                      <circle cx="250" cy="71" r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />

                      <line x1="244" y1="85" x2="144" y2="85" class="stroke-brand-error [stroke-dasharray:5_4]" stroke-width="1.5" stroke-linecap="round" />
                      <circle cx="250" cy="85" r="3" class="fill-white stroke-brand-primary/45" stroke-width="1.1" />
                      <g class="stroke-brand-error" stroke-width="2" stroke-linecap="round">
                        <line x1="131" y1="80" x2="141" y2="90" />
                        <line x1="141" y1="80" x2="131" y2="90" />
                      </g>
                    </svg>
                    <div class="mt-2 flex items-center justify-center gap-2 border border-brand-error/25 bg-brand-error/8 rounded-md px-4 py-2.5">
                      <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 shrink-0 text-brand-error" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8"/></svg>
                      <span class="font-sans text-sm font-bold text-brand-error">{t['engagements.4.diagram.blocked']}</span>
                    </div>
                  </div>
                )}

              </div>
            </div>
          </div>

        </article>
      ))}
    </div>
  </div>
</section>
