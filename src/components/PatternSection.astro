---
import Icon from '@/components/shared/Icon.astro';
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

// Sorted from the most current pattern to the least current one.
const cards = [
  { icon: 'groups', title: t['pattern.7.title'], text: t['pattern.7.reality'] },
  { icon: 'account_tree', title: t['pattern.2.title'], text: t['pattern.2.reality'] },
  { icon: 'autorenew', title: t['pattern.8.title'], text: t['pattern.8.reality'] },
  { icon: 'call_split', title: t['pattern.3.title'], text: t['pattern.3.reality'] },
  { icon: 'rule', title: t['pattern.1.title'], text: t['pattern.1.reality'] },
  { icon: 'route', title: t['pattern.5.title'], text: t['pattern.5.reality'] },
];
---

<section
  id="pattern"
  class="section-pad bg-surface-base"
  aria-labelledby="pattern-heading"
>
  {/* Legacy anchor: external links to /#observations keep landing here */}
  <div id="observations" aria-hidden="true"></div>
  <div class="max-w-300 mx-auto px-gutter xl:px-0">
    <header class="max-w-184 mb-16">
      <p class="text-eyebrow text-brand-primary m-0">
        {t['pattern.subtitle.status_quo']}
      </p>
      <h2
        id="pattern-heading"
        data-speakable
        class="font-sans text-3xl md:text-4xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto m-0 mt-6"
      >
        {t['pattern.heading.status_quo']}
      </h2>
    </header>

    <ul
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 m-0 p-0 list-none"
      role="list"
    >
      {cards.map((card) => (
        <li class="flex flex-col p-10 bg-white border border-ink-primary/13 rounded-lg">
          <Icon name={card.icon} class="w-6 h-6 text-brand-primary shrink-0" />
          <h3 class="font-sans text-xl font-bold text-ink-primary m-0 mt-4 mb-2">
            {card.title}
          </h3>
          <p class="text-body-medium text-ink-muted leading-relaxed m-0">{card.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
