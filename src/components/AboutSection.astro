---
import { Image } from 'astro:assets';
import type { Translations } from '@/i18n/translations';
import profileImage from '@/assets/images/profile-transparent.png';
import { EXTERNAL, getRoutes } from '@/configurations/routes';
import Icon from '@/components/shared/Icon.astro';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;
const routes = getRoutes(Astro.currentLocale);
---

<article id="about">

  <section class="section-pad bg-surface-base" aria-labelledby="about-hero-heading">
    <div class="w-full max-w-300 mx-auto px-gutter xl:px-0">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-x-20 lg:gap-y-0 lg:items-end">

        <div class="max-w-160 min-w-0 lg:col-start-1 lg:row-start-1">
          <p class="text-eyebrow text-brand-primary m-0">
            {t['about.eyebrow']}
          </p>
          <h2
            id="about-hero-heading"
            class="font-sans text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight m-0 mt-4"
          >
            {t['about.heading']}
          </h2>
        </div>

        <div class="min-w-0 flex justify-center lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:justify-end lg:items-end">
          <Image
            src={profileImage}
            alt={t['about.portrait.alt']}
            class="w-full max-w-72 sm:max-w-80 lg:max-w-96 h-auto"
            loading="lazy"
            decoding="async"
            width={360}
            height={541}
            widths={[280, 360, 480, 800]}
            sizes="384px"
            transition:name="profile-portrait"
          />
        </div>

        <div class="max-w-160 min-w-0 lg:col-start-1 lg:row-start-2 lg:mt-9">
          <p class="font-sans text-lg text-ink-muted leading-relaxed m-0 mb-5 max-w-prose">
            {t['about.who.logistics']}
            {t['about.who.stack']}
          </p>
          <p class="font-sans text-lg text-ink-muted leading-relaxed m-0 mb-5 max-w-prose">
            {t['about.who.why.3']}
          </p>
          <p class="font-sans text-lg text-ink-muted leading-relaxed m-0 max-w-prose">
            {t['about.who.why.2']}
          </p>

          <blockquote class="m-0 mt-9 max-w-prose">
            <p class="font-sans text-base font-medium text-brand-primary leading-relaxed m-0">
              {t['about.who.quote']}
            </p>
          </blockquote>

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              href={routes.contact}
              class="inline-flex items-center justify-center px-7 py-3.5 font-sans text-base font-bold rounded-full no-underline transition-all duration-200 hover:-translate-y-0.5 bg-brand-primary text-brand-primary-foreground hover:bg-brand-primary-hover"
            >
              {t['hero.cta']}
            </a>
            <a
              href={EXTERNAL.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 font-sans text-base font-bold rounded-full no-underline border border-brand-primary/35 transition-all duration-200 hover:-translate-y-0.5 bg-transparent text-brand-primary hover:bg-brand-primary/8 hover:border-brand-primary/50"
            >
              <Icon name="linkedin" class="w-5 h-5" />
              {t['about.linkedin.cta']}
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

</article>
