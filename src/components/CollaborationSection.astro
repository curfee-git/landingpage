---
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;
---

<section
  id="collaboration"
  class="section-pad"
  aria-labelledby="collaboration-heading"
>
  {/* Legacy anchor: external links to /#engagement (the old three-tier section) land here */}
  <div id="engagement" aria-hidden="true"></div>
  <div class="max-w-300 mx-auto px-gutter xl:px-0">
    <div class="max-w-184">
      <p class="text-eyebrow text-brand-primary m-0">
        {t['collab.eyebrow']}
      </p>
      <h2
        id="collaboration-heading"
        data-speakable
        class="font-sans text-3xl md:text-4xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto m-0 mt-6"
      >
        {t['collab.heading']}
      </h2>
      <p data-speakable class="font-sans text-lg text-ink-muted leading-relaxed m-0 mt-6 max-w-[65ch]">
        {t['collab.body']}
      </p>
    </div>
  </div>
</section>
