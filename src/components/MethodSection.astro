---
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

const groups = [
  {
    label: t['howiwork.group.1'],
    principles: [
      { mark: '01', title: t['howiwork.1.title'], body: t['howiwork.1.body'] },
      { mark: '02', title: t['howiwork.2.title'], body: t['howiwork.2.body'] },
    ],
  },
  {
    label: t['howiwork.group.2'],
    principles: [
      { mark: '03', title: t['howiwork.3.title'], body: t['howiwork.3.body'] },
      { mark: '04', title: t['howiwork.4.title'], body: t['howiwork.4.body'] },
    ],
  },
  {
    label: t['howiwork.group.3'],
    principles: [
      { mark: '05', title: t['howiwork.5.title'], body: t['howiwork.5.body'] },
    ],
  },
];

const origins = [
  { title: t['method.origin.1.title'], body: t['method.origin.1.body'] },
  { title: t['method.origin.2.title'], body: t['method.origin.2.body'] },
  { title: t['method.origin.3.title'], body: t['method.origin.3.body'] },
  { title: t['method.origin.4.title'], body: t['method.origin.4.body'] },
];
---

<section
  id="method"
  class="section-pad bg-surface-base"
  aria-labelledby="method-heading"
>
  <div class="max-w-300 mx-auto px-gutter xl:px-0">

    <header class="max-w-184 mb-14 lg:mb-18">
      <p class="text-eyebrow text-brand-primary m-0">
        {t['method.eyebrow']}
      </p>
      <h2
        id="method-heading"
        data-speakable
        class="font-sans text-3xl md:text-4xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto m-0 mt-6"
      >
        {t['howiwork.eyebrow']}
      </h2>
    </header>

    <div class="flex flex-col gap-14 lg:gap-16">
      {groups.map((g) => (
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-6">
          <h3 class="lg:col-span-3 font-mono text-xs font-bold uppercase tracking-[0.18em] text-brand-primary m-0 lg:mt-2.5">
            {g.label}
          </h3>
          <div class="lg:col-span-9 flex flex-col gap-8">
            {g.principles.map((p) => (
              <article class="group grid grid-cols-[3.25rem_1fr] lg:grid-cols-[3.75rem_1fr] items-baseline max-w-[62ch]">
                <span
                  class="col-start-1 row-start-1 font-mono text-2xl lg:text-3xl text-brand-primary/40 transition-colors duration-300 group-hover:text-brand-primary leading-none tracking-tight"
                  aria-hidden="true"
                >
                  {p.mark}
                </span>
                <h4 class="col-start-2 row-start-1 font-sans text-xl lg:text-2xl font-bold text-ink-primary m-0 leading-tight tracking-tight">
                  {p.title}
                </h4>
                <p class="col-start-2 row-start-2 font-sans text-base text-ink-muted leading-relaxed m-0 mt-2.5">
                  {p.body}
                </p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="mt-16 lg:mt-20 bg-surface-soft rounded-lg p-8 lg:p-12">
      <h3 class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-brand-primary m-0 mb-7">
        {t['method.origins.heading']}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-8">
        {origins.map((o) => (
          <article class="max-w-[62ch]">
            <h4 class="font-sans text-base font-bold text-ink-primary m-0 leading-tight">
              {o.title}
            </h4>
            <p class="font-sans text-base text-ink-muted leading-relaxed m-0 mt-2">
              {o.body}
            </p>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>
