---
import type { Translations } from '@/i18n/translations';

interface Props {
  translations: Translations;
}
const { translations: t } = Astro.props;

const principles = [
  { mark: '01', title: t['howiwork.1.title'], body: t['howiwork.1.body'] },
  { mark: '02', title: t['howiwork.2.title'], body: t['howiwork.2.body'] },
  { mark: '03', title: t['howiwork.3.title'], body: t['howiwork.3.body'] },
  { mark: '04', title: t['howiwork.4.title'], body: t['howiwork.4.body'] },
];

const origins = [
  { title: t['method.origin.1.title'], body: t['method.origin.1.body'] },
  { title: t['method.origin.2.title'], body: t['method.origin.2.body'] },
  { title: t['method.origin.3.title'], body: t['method.origin.3.body'] },
];
---

<section
  id="method"
  class="section-pad bg-surface-base"
  aria-labelledby="method-heading"
>
  <div class="max-w-300 mx-auto px-gutter xl:px-0">
    <header class="max-w-184 mb-16">
      <p class="text-eyebrow text-brand-primary m-0">
        {t['method.eyebrow']}
      </p>
      <h2
        id="method-heading"
        data-speakable
        class="font-sans text-3xl md:text-4xl font-bold leading-[1.05] tracking-tight text-balance break-words hyphens-auto m-0 mt-6"
      >
        {t['howiwork.eyebrow']}
      </h2>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {principles.map((p) => (
        <article class="flex flex-col p-10 bg-white border border-ink-primary/13 rounded-lg">
          <p class="font-mono text-sm font-bold text-brand-primary m-0" aria-hidden="true">
            {p.mark}
          </p>
          <h3 class="font-sans text-xl font-bold text-ink-primary m-0 mt-4 mb-2 leading-tight">
            {p.title}
          </h3>
          <p class="text-body-medium text-ink-muted leading-relaxed m-0">
            {p.body}
          </p>
        </article>
      ))}
    </div>

    <div class="mt-16 lg:mt-20">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-brand-primary m-0 mb-6">
        {t['method.origins.heading']}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-8">
        {origins.map((o) => (
          <div>
            <h3 class="font-sans text-lg font-bold text-ink-primary m-0 mb-2 leading-tight">
              {o.title}
            </h3>
            <p class="text-body-medium text-ink-muted leading-relaxed m-0">
              {o.body}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
