---
import Layout from '@/layouts/Layout.astro';
import ServiceDetail from '@/components/ServiceDetail.astro';
import { getTranslations } from '@/i18n/translations';

const t = getTranslations();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://curfee.com/services/guidance/#service',
  name: t['services.guidance.title'],
  alternateName: ['Guidance', 'Curfee Guidance', 'Architecture Implementation', 'Architecture Implementation Guidance'],
  description: t['meta.services.guidance.description'],
  slogan: t['services.guidance.subtitle'],
  serviceType: t['schema.offer.guidance.service.type'],
  category: t['schema.offer.guidance.category'],
  provider: { '@id': 'https://curfee.com/#organization' },
  brand: { '@id': 'https://curfee.com/#organization' },
  isPartOf: { '@id': 'https://curfee.com/#services' },
  isRelatedTo: { '@id': 'https://curfee.com/#decision-enforcement-principle' },
  mainEntityOfPage: 'https://curfee.com/services/guidance/',
  areaServed: [
    { '@type': 'Country', name: t['schema.country.austria'] },
    { '@type': 'Country', name: t['schema.country.germany'] },
    { '@type': 'Country', name: t['schema.country.switzerland'] },
  ],
  audience: {
    '@type': 'BusinessAudience',
    name: t['schema.audience.name'],
    audienceType: t['schema.audience.type'],
  },
  availableLanguage: ['en', 'de'],
};

const timeline = [
  {
    phase: t['services.guidance.timeline.1.phase'],
    title: t['services.guidance.timeline.1.title'],
    outcome: t['services.guidance.timeline.1.outcome'],
    items: [t['services.guidance.timeline.1.item.1'], t['services.guidance.timeline.1.item.2'], t['services.guidance.timeline.1.item.3']],
  },
  {
    phase: t['services.guidance.timeline.2.phase'],
    title: t['services.guidance.timeline.2.title'],
    outcome: t['services.guidance.timeline.2.outcome'],
    items: [t['services.guidance.timeline.2.item.1'], t['services.guidance.timeline.2.item.2'], t['services.guidance.timeline.2.item.3']],
  },
  {
    phase: t['services.guidance.timeline.3.phase'],
    title: t['services.guidance.timeline.3.title'],
    outcome: t['services.guidance.timeline.3.outcome'],
    items: [t['services.guidance.timeline.3.item.1'], t['services.guidance.timeline.3.item.2'], t['services.guidance.timeline.3.item.3']],
  },
  {
    phase: t['services.guidance.timeline.4.phase'],
    title: t['services.guidance.timeline.4.title'],
    outcome: t['services.guidance.timeline.4.outcome'],
    items: [t['services.guidance.timeline.4.item.1'], t['services.guidance.timeline.4.item.2'], t['services.guidance.timeline.4.item.3']],
  },
];

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How a ${t['services.guidance.title']} engagement works`,
  description: t['meta.services.guidance.description'],
  step: timeline.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.outcome,
  })),
};
---

<Layout
  title={t['meta.services.guidance.title']}
  description={t['meta.services.guidance.description']}
  canonicalPath={Astro.url.pathname}
  jsonLd={[jsonLd, howToJsonLd]}
>
  <ServiceDetail
    serviceKey="guidance"
    title={t['services.guidance.title']}
    subtitle={t['services.guidance.subtitle']}
    problem={t['services.guidance.problem']}
    timeline={timeline}
    delivers={[t['services.guidance.delivers.1'], t['services.guidance.delivers.2'], t['services.guidance.delivers.3'], t['services.guidance.delivers.4'], t['services.guidance.delivers.5'], t['services.guidance.delivers.6']]}
    excludes={[t['services.guidance.excludes.1'], t['services.guidance.excludes.2'], t['services.guidance.excludes.3']]}
    cta={t['services.guidance.cta']}
    translations={t}
    accent="secondary"
  />
</Layout>
