---
import Layout from '@/layouts/Layout.astro';
import ServiceDetail from '@/components/ServiceDetail.astro';
import { getTranslations } from '@/i18n/translations';

const t = getTranslations();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://curfee.com/services/diagnosis/#service',
  name: t['services.diagnosis.title'],
  alternateName: ['Diagnosis', 'Curfee Diagnosis', 'Root Cause Analysis', 'Structural Diagnosis'],
  description: t['meta.services.diagnosis.description'],
  slogan: t['services.diagnosis.subtitle'],
  serviceType: t['schema.offer.diagnosis.service.type'],
  category: t['schema.offer.diagnosis.category'],
  provider: { '@id': 'https://curfee.com/#organization' },
  brand: { '@id': 'https://curfee.com/#organization' },
  isPartOf: { '@id': 'https://curfee.com/#services' },
  isRelatedTo: { '@id': 'https://curfee.com/#decision-enforcement-principle' },
  mainEntityOfPage: 'https://curfee.com/services/diagnosis/',
  areaServed: [
    { '@type': 'Country', name: t['schema.country.austria'] },
    { '@type': 'Country', name: t['schema.country.germany'] },
    { '@type': 'Country', name: t['schema.country.switzerland'] },
  ],
  audience: {
    '@type': 'BusinessAudience',
    name: t['schema.audience.name'],
    audienceType: t['schema.audience.type'],
  },
  availableLanguage: ['en', 'de'],
};

const timeline = [
  {
    phase: t['services.diagnosis.timeline.1.phase'],
    title: t['services.diagnosis.timeline.1.title'],
    outcome: t['services.diagnosis.timeline.1.outcome'],
    items: [t['services.diagnosis.timeline.1.item.1'], t['services.diagnosis.timeline.1.item.2'], t['services.diagnosis.timeline.1.item.3']],
  },
  {
    phase: t['services.diagnosis.timeline.2.phase'],
    title: t['services.diagnosis.timeline.2.title'],
    outcome: t['services.diagnosis.timeline.2.outcome'],
    items: [t['services.diagnosis.timeline.2.item.1'], t['services.diagnosis.timeline.2.item.2'], t['services.diagnosis.timeline.2.item.3']],
  },
  {
    phase: t['services.diagnosis.timeline.3.phase'],
    title: t['services.diagnosis.timeline.3.title'],
    outcome: t['services.diagnosis.timeline.3.outcome'],
    items: [t['services.diagnosis.timeline.3.item.1'], t['services.diagnosis.timeline.3.item.2'], t['services.diagnosis.timeline.3.item.3']],
  },
];

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How a ${t['services.diagnosis.title']} engagement works`,
  description: t['meta.services.diagnosis.description'],
  step: timeline.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.outcome,
  })),
};
---

<Layout
  title={t['meta.services.diagnosis.title']}
  description={t['meta.services.diagnosis.description']}
  canonicalPath={Astro.url.pathname}
  jsonLd={[jsonLd, howToJsonLd]}
>
  <ServiceDetail
    serviceKey="diagnosis"
    title={t['services.diagnosis.title']}
    subtitle={t['services.diagnosis.subtitle']}
    problem={t['services.diagnosis.problem']}
    timeline={timeline}
    delivers={[t['services.diagnosis.delivers.1'], t['services.diagnosis.delivers.2'], t['services.diagnosis.delivers.3'], t['services.diagnosis.delivers.4'], t['services.diagnosis.delivers.5'], t['services.diagnosis.delivers.6'], t['services.diagnosis.delivers.7'], t['services.diagnosis.delivers.8']]}
    excludes={[t['services.diagnosis.excludes.1'], t['services.diagnosis.excludes.2'], t['services.diagnosis.excludes.3'], t['services.diagnosis.excludes.4']]}
    cta={t['services.diagnosis.cta']}
    translations={t}
    accent="primary"
  />
</Layout>
