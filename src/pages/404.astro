---
import Layout from '@/layouts/Layout.astro';
import { getRoutes } from '@/configurations/routes';
import { getTranslations } from '@/i18n/translations';

const t = getTranslations(Astro.currentLocale);
const tDe = getTranslations('de');
const notFoundDe = {
  title: tDe['meta.404.title'],
  heading: tDe['404.heading'],
  description: tDe['404.description'],
  cta: tDe['404.cta'],
};
const routes = getRoutes(Astro.currentLocale);
---

<Layout
  title={t['meta.404.title']}
  description={t['meta.404.description']}
  canonicalPath={Astro.url.pathname}
  noindex={true}
  footerDivider={true}
>
  <article class="section-pad flex-1 flex items-center">
    <div class="max-w-300 mx-auto px-gutter xl:px-0">
      <div class="max-w-180 mx-auto text-center">
        <p
          class="font-sans text-8xl sm:text-9xl md:text-[11rem] font-bold leading-none tracking-tight text-brand-primary m-0 mb-4 select-none"
          aria-hidden="true"
        >404</p>
        <h1 data-notfound-heading class="font-sans text-2xl md:text-3xl font-bold leading-tight tracking-tight text-ink-primary m-0 text-balance">
          {t['404.heading']}
        </h1>
        <p data-notfound-description class="font-sans text-base text-ink-muted leading-relaxed mt-4 mx-auto max-w-120">
          {t['404.description']}
        </p>
        <a
          data-notfound-cta
          href={routes.home}
          class="inline-flex items-center justify-center mt-8 px-7 py-3.5 font-sans text-base font-bold rounded-full no-underline transition-colors duration-200 bg-brand-primary text-brand-primary-foreground hover:bg-brand-primary-hover"
        >
          {t['404.cta']}
        </a>
      </div>
    </div>
  </article>
</Layout>

<script is:inline define:vars={{ notFoundDe }}>
  (function () {
    try {
      var path = location.pathname;
      var isDe =
        path === '/de' ||
        path.indexOf('/de/') === 0 ||
        localStorage.getItem('curfee-lang') === 'de';
      if (!isDe) return;
      document.documentElement.lang = 'de';
      document.title = notFoundDe.title;
      var heading = document.querySelector('[data-notfound-heading]');
      var description = document.querySelector('[data-notfound-description]');
      var cta = document.querySelector('[data-notfound-cta]');
      if (heading) heading.textContent = notFoundDe.heading;
      if (description) description.textContent = notFoundDe.description;
      if (cta) {
        cta.textContent = notFoundDe.cta;
        cta.setAttribute('href', '/de/');
      }
    } catch (e) {}
  })();
</script>
