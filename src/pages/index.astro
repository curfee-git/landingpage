---
import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/HeroSection.astro';
import WhyCurfeeSection from '@/components/WhyCurfeeSection.astro';
import PatternSection from '@/components/PatternSection.astro';
import SelectedEngagementsSection from '@/components/SelectedEngagementsSection.astro';
import MethodSection from '@/components/MethodSection.astro';
import EngagementSection from '@/components/EngagementSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ManifestSection from '@/components/ManifestSection.astro';
import ContactSection from '@/components/ContactSection.astro';
import FaqSection from '@/components/FaqSection.astro';
import { getTranslations } from '@/i18n/translations';

const t = getTranslations(Astro.currentLocale);
const locale = Astro.currentLocale === 'de' ? 'de' : 'en';

const buildDate = new Date().toISOString().slice(0, 10);

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://curfee.com/#services",
  "name": t['schema.service.name'],
  "alternateName": t['schema.service.alternate.name'],
  "description": t['schema.service.description'],
  "provider": { "@id": "https://curfee.com/#organization" },
  "brand": { "@id": "https://curfee.com/#organization" },
  "serviceType": t['schema.service.type'],
  "category": t['schema.service.category'],
  "areaServed": [
    { "@type": "Country", "name": t['schema.country.austria'] },
    { "@type": "Country", "name": t['schema.country.germany'] },
    { "@type": "Country", "name": t['schema.country.switzerland'] }
  ],
  "audience": {
    "@type": "BusinessAudience",
    "name": t['schema.audience.name'],
    "audienceType": t['schema.audience.type']
  },
  "serviceOutput": t['schema.service.output'],
  "termsOfService": "https://curfee.com/imprint/",
  "isRelatedTo": { "@id": "https://curfee.com/#decisions-that-enforce-themselves" },
  "availableLanguage": ["en", "de"]
};

const mechanismLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "@id": "https://curfee.com/#decisions-that-enforce-themselves",
  "name": t['schema.mechanism.name'],
  "alternateName": [
    "Machine-checked decisions",
    "Self-checking decisions"
  ],
  "description": t['schema.mechanism.description'],
  "termCode": "decisions-that-enforce-themselves",
  "url": "https://curfee.com/#decisions-that-enforce-themselves",
  "inDefinedTermSet": {
    "@type": "DefinedTermSet",
    "@id": "https://curfee.com/#glossary",
    "name": t['schema.glossary.name'],
    "url": "https://curfee.com/llms.txt",
    "inLanguage": "en",
    "publisher": { "@id": "https://curfee.com/#organization" }
  },
  "subjectOf": { "@id": "https://curfee.com/#organization" },
  "author": { "@id": "https://curfee.com/#founder" },
  "creator": { "@id": "https://curfee.com/#founder" }
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://curfee.com/#faq",
  "isPartOf": { "@id": "https://curfee.com/#website" },
  "about": { "@id": "https://curfee.com/#organization" },
  "author": { "@id": "https://curfee.com/#founder" },
  "inLanguage": locale,
  "mainEntity": [
    { "q": t['faq.1.question'], "a": t['faq.1.answer'] },
    { "q": t['faq.2.question'], "a": t['faq.2.answer'] },
    { "q": t['faq.3.question'], "a": t['faq.3.answer'] },
    { "q": t['faq.4.question'], "a": t['faq.4.answer'] },
    { "q": t['faq.5.question'], "a": t['faq.5.answer'] },
    { "q": t['faq.6.question'], "a": t['faq.6.answer'] },
  ].map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a }
  }))
};

const jsonLd = [serviceLd, mechanismLd, faqLd];
---

<Layout
  title={t['meta.home.title']}
  description={t['meta.home.description']}
  canonicalPath={Astro.url.pathname}
  jsonLd={jsonLd}
  dateModified={buildDate}
  hasSpeakable={true}
>
  <HeroSection translations={t} />
  <PatternSection translations={t} />
  <SelectedEngagementsSection />
  <WhyCurfeeSection translations={t} />
  <MethodSection translations={t} />
  <ManifestSection text={t['method.closer']} />
  <EngagementSection translations={t} />
  <AboutSection translations={t} />
  <FaqSection translations={t} />
  <ContactSection translations={t} />
</Layout>
