---
import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/HeroSection.astro';
import WhyCurfeeSection from '@/components/WhyCurfeeSection.astro';
import ObservationsSection from '@/components/ObservationsSection.astro';
import ServicesSection from '@/components/ServicesSection.astro';
import DifferentiatorSection from '@/components/DifferentiatorSection.astro';
import QuoteSection from '@/components/QuoteSection.astro';
import ContactSection from '@/components/ContactSection.astro';
import { getTranslations } from '@/i18n/translations';

const t = getTranslations();

const buildDate = new Date().toISOString().slice(0, 10);

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://curfee.com/#services",
  "name": t['schema.service.name'],
  "alternateName": t['schema.service.alternate.name'],
  "description": t['schema.service.description'],
  "provider": { "@id": "https://curfee.com/#organization" },
  "brand": { "@id": "https://curfee.com/#organization" },
  "serviceType": t['schema.service.type'],
  "category": t['schema.service.category'],
  "areaServed": [
    { "@type": "Country", "name": t['schema.country.austria'] },
    { "@type": "Country", "name": t['schema.country.germany'] },
    { "@type": "Country", "name": t['schema.country.switzerland'] }
  ],
  "audience": {
    "@type": "BusinessAudience",
    "name": t['schema.audience.name'],
    "audienceType": t['schema.audience.type']
  },
  "serviceOutput": t['schema.service.output'],
  "termsOfService": "https://curfee.com/imprint/",
  "isRelatedTo": { "@id": "https://curfee.com/#decision-enforcement-principle" },
  "availableLanguage": ["en", "de"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "@id": "https://curfee.com/#offer-catalog",
    "name": t['services.heading'],
    "itemListElement": [
      {
        "@type": "Offer",
        "@id": "https://curfee.com/#offer-diagnosis",
        "category": t['schema.offer.diagnosis.category'],
        "availability": "https://schema.org/InStock",
        "priceCurrency": "EUR",
        "eligibleDuration": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 4, "unitCode": "WEE" },
        "itemOffered": { "@id": "https://curfee.com/services/diagnosis/#service" }
      },
      {
        "@type": "Offer",
        "@id": "https://curfee.com/#offer-guidance",
        "category": t['schema.offer.guidance.category'],
        "availability": "https://schema.org/InStock",
        "priceCurrency": "EUR",
        "eligibleDuration": { "@type": "QuantitativeValue", "minValue": 3, "maxValue": 6, "unitCode": "MON" },
        "itemOffered": { "@id": "https://curfee.com/services/guidance/#service" }
      },
      {
        "@type": "Offer",
        "@id": "https://curfee.com/#offer-sparring",
        "category": t['schema.offer.sparring.category'],
        "availability": "https://schema.org/InStock",
        "priceCurrency": "EUR",
        "itemOffered": { "@id": "https://curfee.com/services/sparring/#service" }
      },
    ]
  }
};

const decisionEnforcementLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "@id": "https://curfee.com/#decision-enforcement-principle",
  "name": t['schema.decision.enforcement.name'],
  "alternateName": [
    "Decision Enforcement",
    "Decision Enforcement Principle",
    "Curfee Decision Enforcement Principle",
    "DEP"
  ],
  "description": t['schema.decision.enforcement.description'],
  "termCode": "decision-enforcement-principle",
  "url": "https://curfee.com/#decision-enforcement-principle",
  "inDefinedTermSet": {
    "@type": "DefinedTermSet",
    "@id": "https://curfee.com/#glossary",
    "name": t['schema.glossary.name'],
    "url": "https://curfee.com/llms.txt",
    "inLanguage": "en",
    "publisher": { "@id": "https://curfee.com/#organization" }
  },
  "subjectOf": { "@id": "https://curfee.com/#organization" },
  "author": { "@id": "https://curfee.com/#founder" },
  "creator": { "@id": "https://curfee.com/#founder" }
};

const jsonLd = [serviceLd, decisionEnforcementLd];
---

<Layout
  title={t['meta.home.title']}
  description={t['meta.home.description']}
  canonicalPath={Astro.url.pathname}
  jsonLd={jsonLd}
  dateModified={buildDate}
  hasSpeakable={true}
>
  <HeroSection translations={t} />
  <WhyCurfeeSection translations={t} />
  <ObservationsSection translations={t} />
  <ServicesSection translations={t} />
  <DifferentiatorSection />
  <QuoteSection translations={t} />
  <ContactSection translations={t} />
</Layout>
