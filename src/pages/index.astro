---
import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/HeroSection.astro';
import PatternSection from '@/components/PatternSection.astro';
import SelectedEngagementsSection from '@/components/SelectedEngagementsSection.astro';
import DecisionSection from '@/components/DecisionSection.astro';
import ScopeSection from '@/components/ScopeSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import CollaborationSection from '@/components/CollaborationSection.astro';
import ContactSection from '@/components/ContactSection.astro';
import FaqSection from '@/components/FaqSection.astro';
import { getTranslations } from '@/i18n/translations';
import { getRoutes } from '@/configurations/routes';

const t = getTranslations(Astro.currentLocale);
const locale = Astro.currentLocale === 'de' ? 'de' : 'en';
const routes = getRoutes(Astro.currentLocale);
const siteUrl = 'https://curfee.com';

const buildDate = new Date().toISOString().slice(0, 10);

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteUrl}/#services`,
  "name": t['schema.service.name'],
  "alternateName": t['schema.service.alternate.name'],
  "description": t['schema.service.description'],
  "provider": { "@id": `${siteUrl}/#organization` },
  "brand": { "@id": `${siteUrl}/#organization` },
  "serviceType": t['schema.service.type'],
  "category": t['schema.service.category'],
  "areaServed": [
    { "@type": "Country", "name": t['schema.country.austria'] },
    { "@type": "Country", "name": t['schema.country.germany'] },
    { "@type": "Country", "name": t['schema.country.switzerland'] }
  ],
  "audience": {
    "@type": "BusinessAudience",
    "name": t['schema.audience.name'],
    "audienceType": t['schema.audience.type']
  },
  "serviceOutput": t['schema.service.output'],
  "termsOfService": `${siteUrl}${routes.imprint}`,
  "isRelatedTo": { "@id": `${siteUrl}/#decisions-that-enforce-themselves` },
  "availableLanguage": ["en", "de"]
};

const mechanismLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "@id": `${siteUrl}/#decisions-that-enforce-themselves`,
  "name": t['schema.mechanism.name'],
  "alternateName": [
    "Machine-checked decisions",
    "Self-checking decisions"
  ],
  "description": t['schema.mechanism.description'],
  "termCode": "decisions-that-enforce-themselves",
  "url": `${siteUrl}/#decisions-that-enforce-themselves`,
  "inDefinedTermSet": {
    "@type": "DefinedTermSet",
    "@id": `${siteUrl}/#glossary`,
    "name": t['schema.glossary.name'],
    "url": `${siteUrl}/llms.txt`,
    "inLanguage": "en",
    "publisher": { "@id": `${siteUrl}/#organization` }
  },
  "subjectOf": { "@id": `${siteUrl}/#organization` },
  "author": { "@id": `${siteUrl}/#founder` },
  "creator": { "@id": `${siteUrl}/#founder` }
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${siteUrl}/#faq`,
  "isPartOf": { "@id": `${siteUrl}/#website` },
  "about": { "@id": `${siteUrl}/#organization` },
  "author": { "@id": `${siteUrl}/#founder` },
  "inLanguage": locale,
  "mainEntity": [
    { "q": t['faq.1.question'], "a": t['faq.1.answer'] },
    { "q": t['faq.2.question'], "a": t['faq.2.answer'] },
    { "q": t['faq.3.question'], "a": t['faq.3.answer'] },
    { "q": t['faq.4.question'], "a": t['faq.4.answer'] },
    { "q": t['faq.5.question'], "a": t['faq.5.answer'] },
  ].map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a }
  }))
};

const jsonLd = [serviceLd, mechanismLd, faqLd];
---

<Layout
  title={t['meta.home.title']}
  description={t['meta.home.description']}
  canonicalPath={Astro.url.pathname}
  jsonLd={jsonLd}
  dateModified={buildDate}
  hasSpeakable={true}
>
  <HeroSection translations={t} />
  <SelectedEngagementsSection />
  <PatternSection translations={t} />
  <DecisionSection translations={t} />
  <ScopeSection translations={t} />
  <AboutSection translations={t} />
  <CollaborationSection translations={t} />
  <FaqSection translations={t} />
  <ContactSection translations={t} />
</Layout>
